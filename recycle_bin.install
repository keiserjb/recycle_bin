<?php

/**
 * @file
 * Install, update, and uninstall hooks for Recycle Bin.
 */

/**
 * Implements hook_schema().
 */
function recycle_bin_schema() {
  $schema['recycle_bin_entity'] = array(
    'description' => 'Current soft-delete markers for Recycle Bin entities.',
    'fields' => array(
      'entity_type' => array(
        'type' => 'varchar',
        'length' => 32,
        'not null' => TRUE,
      ),
      'entity_id' => array(
        'type' => 'varchar',
        'length' => 128,
        'not null' => TRUE,
      ),
      'bundle' => array(
        'type' => 'varchar',
        'length' => 128,
        'not null' => FALSE,
      ),
      'deleted' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
      'deleted_uid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ),
      'deleted_vid' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => FALSE,
      ),
      'purge_attempted' => array(
        'type' => 'int',
        'unsigned' => TRUE,
        'not null' => TRUE,
        'default' => 0,
      ),
    ),
    'primary key' => array('entity_type', 'entity_id'),
    'indexes' => array(
      'deleted' => array('deleted'),
      'purge_attempted' => array('purge_attempted'),
      'bundle' => array('entity_type', 'bundle'),
    ),
  );
  return $schema;
}

/**
 * Returns the legacy configuration snapshot schema for update compatibility.
 *
 * New configuration snapshots are owned by config_history. This function is
 * retained only so sites upgrading from the earlier Recycle Bin build can
 * complete update 7001 and let config_history migrate the old table.
 */
function recycle_bin_legacy_config_snapshot_schema() {
  return array(
    'description' => 'Legacy configuration snapshots awaiting config_history migration.',
    'fields' => array(
      'snapshot_id' => array('type' => 'serial', 'unsigned' => TRUE, 'not null' => TRUE),
      'config_name' => array('type' => 'varchar', 'length' => 250, 'not null' => TRUE),
      'data' => array('type' => 'text', 'size' => 'big', 'not null' => TRUE),
      'created' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE),
      'uid' => array('type' => 'int', 'unsigned' => TRUE, 'not null' => TRUE, 'default' => 0),
      'operation' => array('type' => 'varchar', 'length' => 32, 'not null' => TRUE),
    ),
    'primary key' => array('snapshot_id'),
    'indexes' => array(
      'config_name' => array('config_name'),
      'created' => array('created'),
    ),
  );
}

/**
 * Adds managed-file settings.
 */
function recycle_bin_update_7001() {
  $config = config('recycle_bin.settings');
  if ($config->get('file_adapter_enabled') === NULL) {
    $config->set('file_adapter_enabled', FALSE)->save();
  }
}

/**
 * Migrates 'enabled_bundles' from a flat node-only list to a per-entity-type
 * map, so additional adapters (e.g. taxonomy_term) can have their own
 * enabled-bundle list under the same config key.
 *
 * Before: {"enabled_bundles": ["post", "page"]}
 * After:  {"enabled_bundles": {"node": ["post", "page"]}}
 */
function recycle_bin_update_7002() {
  $config = config('recycle_bin.settings');
  $enabled = $config->get('enabled_bundles');
  $is_legacy_flat_list = is_array($enabled);
  if ($is_legacy_flat_list) {
    foreach ($enabled as $value) {
      if (is_array($value)) {
        $is_legacy_flat_list = FALSE;
        break;
      }
    }
  }
  if ($is_legacy_flat_list) {
    $config->set('enabled_bundles', array('node' => array_values($enabled)))->save();
  }
}

/**
 * Adds automatic-purge retry tracking and removes empty legacy snapshot data.
 */
function recycle_bin_update_7003() {
  if (!db_field_exists('recycle_bin_entity', 'purge_attempted')) {
    $field = array(
      'type' => 'int',
      'unsigned' => TRUE,
      'not null' => TRUE,
      'default' => 0,
    );
    db_add_field('recycle_bin_entity', 'purge_attempted', $field, array(
      'indexes' => array('purge_attempted' => array('purge_attempted')),
    ));
  }
  if (!db_index_exists('recycle_bin_entity', 'purge_attempted')) {
    db_add_index('recycle_bin_entity', 'purge_attempted', array('purge_attempted'));
  }

  // Earlier development builds created this table for a configuration-history
  // feature that Recycle Bin no longer owns. Empty tables are safe to remove;
  // nonempty tables are preserved and surfaced on the status report so an
  // operator can export or migrate them without data loss.
  if (db_table_exists('recycle_bin_config_snapshot')) {
    $count = db_query('SELECT COUNT(*) FROM {recycle_bin_config_snapshot}')->fetchField();
    if (!$count) {
      db_drop_table('recycle_bin_config_snapshot');
    }
  }
}

/**
 * Implements hook_install().
 */
function recycle_bin_install() {
  config_install_default_config('module', 'recycle_bin');
}

/**
 * Implements hook_disable().
 */
function recycle_bin_disable() {
  if (!db_table_exists('recycle_bin_entity')) {
    return;
  }
  $released = recycle_bin_release_all_markers();
  if ($released) {
    $message = format_plural($released,
      'Disabling Recycle Bin restored or released 1 item.',
      'Disabling Recycle Bin restored or released @count items.');
    backdrop_set_message($message, 'warning');
    watchdog('recycle_bin', $message, array(), WATCHDOG_WARNING);
  }
}

/**
 * Implements hook_uninstall().
 */
function recycle_bin_uninstall() {
  config_uninstall_config('recycle_bin');
  foreach (array('recycle_bin_entity') as $table) {
    if (db_table_exists($table)) {
      db_drop_table($table);
    }
  }
}
