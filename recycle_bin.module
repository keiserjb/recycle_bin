  $items['admin/config/content/recycle-bin'] = array(
    'title' => 'Recycle Bin',
    'description' => 'Configure which content types are sent to the Recycle Bin on delete, and automatic permanent deletion.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('recycle_bin_settings_form'),
    'access callback' => 'recycle_bin_administer_access',
    'type' => MENU_NORMAL_ITEM,
  );
  $items['admin/content/recycle-bin'] = array(
    'title' => 'Recycle Bin',
    'description' => 'Review, restore, or permanently delete deleted content.',
    'page callback' => 'recycle_bin_listing',
    'access callback' => 'recycle_bin_access',
    'type' => MENU_LOCAL_TASK,
  );
  $items['admin/content/recycle-bin/%/restore'] = array(
    'title' => 'Restore',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('recycle_bin_restore_form', 3),
    'access callback' => 'recycle_bin_restore_access',
    'type' => MENU_CALLBACK,
  );
  $items['admin/content/recycle-bin/%/purge'] = array(
    'title' => 'Delete permanently',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('recycle_bin_purge_form', 3),
    'access callback' => 'recycle_bin_purge_access',
    'type' => MENU_CALLBACK,
  );
  $items['admin/content/recycle-bin/%/%/restore'] = array(
    'title' => 'Restore',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('recycle_bin_entity_restore_form', 3, 4),
    'access callback' => 'recycle_bin_restore_access',
    'type' => MENU_CALLBACK,
  );
  $items['admin/content/recycle-bin/%/%/purge'] = array(
    'title' => 'Delete permanently',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('recycle_bin_entity_purge_form', 3, 4),
    'access callback' => 'recycle_bin_purge_access',
    'type' => MENU_CALLBACK,
  );
  return $items;
}

/**
 * Implements hook_views_api().
 */
function recycle_bin_views_api() {
  return array('api' => 3);
}

/**
 * Implements hook_entity_query_alter().
 */
function recycle_bin_entity_query_alter($query) {
  if (!empty($query->entityConditions['entity_type']['value']) && recycle_bin_context() !== 'ignore') {
    $entity_type = $query->entityConditions['entity_type']['value'];
    $adapter = recycle_bin_get_adapter($entity_type);
    if (!$adapter) {
      return;
    }
    $query->addTag('recycle_bin');
    $query->addMetaData('recycle_bin_entity_type', $entity_type);
    $query->addMetaData('recycle_bin_base_alias', $adapter['base table']);
  }
}

/**
 * Implements hook_query_TAG_alter() for tagged EntityFieldQuery and Views SQL.
 */
function recycle_bin_query_recycle_bin_alter($query) {
  $context = recycle_bin_context();
  if ($context === 'ignore') {
    return;
  }

  $entity_type = $query->getMetaData('recycle_bin_entity_type');
  $base_alias = $query->getMetaData('recycle_bin_base_alias');
  if (!$entity_type) {
    // Views supplies the tag through its query plugin. Find a registered base
    // table in the final SQL query before adding the marker join.
    $tables = $query->getTables();
    foreach ($tables as $alias => $table) {
      if (!empty($table['table'])) {
        foreach (recycle_bin_get_adapters() as $candidate_type => $candidate) {
          if ($table['table'] === $candidate['base table']) {
            $entity_type = $candidate_type;
            $base_alias = $alias;
            break 2;
          }
        }
      }
    }
  }
  $adapter = $entity_type ? recycle_bin_get_adapter($entity_type) : FALSE;
  if (!$adapter || !$base_alias) {
    return;
  }

  $alias = $query->leftJoin(
    'recycle_bin_entity',
    'recycle_bin',
    '%alias.entity_type = :recycle_bin_entity_type AND %alias.entity_id = ' . $base_alias . '.' . $adapter['id key'],
    array(':recycle_bin_entity_type' => $entity_type)
  );
  if ($context === 'recycle_bin') {
    $query->condition($alias . '.entity_id', NULL, 'IS NOT NULL');
  }
  else {
    $query->condition($alias . '.entity_id', NULL, 'IS NULL');
  }
}

/**
 * Implements hook_node_access().
 */
function recycle_bin_node_access($op, $node, $account) {
  if (empty($node->nid) || !recycle_bin_is_deleted('node', $node->nid)) {
    return NODE_ACCESS_IGNORE;
  }
  if (!recycle_bin_entity_access('node', $node, $account)) {
    return NODE_ACCESS_DENY;
  }
  return NODE_ACCESS_IGNORE;
}

/**
 * Implements hook_file_access().
 *
 * A metadata-only file adapter cannot protect a public URI from someone who
 * already knows it. This hook prevents normal entity access to marked files
 * while retaining permissioned inspection in Recycle Bin context.
 */
function recycle_bin_file_access($op, $file, $account) {
  if (!$file instanceof File || empty($file->fid) || !recycle_bin_is_deleted('file', $file->fid)) {
    return FILE_ACCESS_IGNORE;
  }
  if (recycle_bin_context() === 'recycle_bin' && $op === 'view' && user_access('view deleted entities', $account)) {
    return FILE_ACCESS_ALLOW;
  }
  return FILE_ACCESS_DENY;
}

/**
 * Implements hook_requirements().
 */
function recycle_bin_requirements($phase) {
  $requirements = array();
  if ($phase !== 'runtime') {
    return $requirements;
  }
  $requirements['recycle_bin_marker_table'] = array(
    'title' => t('Recycle Bin marker table'),
    'value' => db_table_exists('recycle_bin_entity') ? t('Present') : t('Missing'),
    'severity' => db_table_exists('recycle_bin_entity') ? REQUIREMENT_OK : REQUIREMENT_ERROR,
  );
  foreach (recycle_bin_get_adapters() as $entity_type => $adapter) {
    $info = entity_get_info($entity_type);
    $active = !empty($info['controller class']) && $info['controller class'] === $adapter['replacement class'];
    if (!$active) {
      $requirements['recycle_bin_adapter_' . $entity_type] = array(
        'title' => t('Recycle Bin @type adapter', array('@type' => $entity_type)),
        'value' => t('Controller conflict or unavailable replacement'),
        'severity' => REQUIREMENT_WARNING,
        'description' => t('The entity remains permanently delete-only until its registered replacement controller is active.'),
      );
    }
  }
  return $requirements;
}

/**
 * Returns the current request context.
 *
 * @param string|null $context
 *   Set the context when supplied. Valid values are active, recycle_bin, and
 *   ignore.
 *
 * @return string
 *   The current context.
 */
function recycle_bin_context($context = NULL) {
  $current = &backdrop_static(__FUNCTION__, 'active');
  if ($context !== NULL) {
    if (!in_array($context, array('active', 'recycle_bin', 'ignore'), TRUE)) {
      throw new InvalidArgumentException('Invalid Recycle Bin context.');
    }
    $current = $context;
  }
  return $current;
}

/**
 * Runs a callback in a temporary context and always restores the old context.
 */
function recycle_bin_with_context($context, $callback, array $args = array()) {
  $previous = recycle_bin_context();
  recycle_bin_context($context);
  try {
    return call_user_func_array($callback, $args);
  }
  finally {
    recycle_bin_context($previous);
  }
}

/**
 * Returns whether a bundle is enabled for soft deletion.
 */
function recycle_bin_is_bundle_enabled($entity_type, $bundle) {
  if ($entity_type !== 'node') {
    return FALSE;
  }
  $enabled = config_get('recycle_bin.settings', 'enabled_bundles');
  return in_array($bundle, is_array($enabled) ? $enabled : array(), TRUE);
}

/**
 * Returns a current marker row, or FALSE.
 */
function recycle_bin_get_marker($entity_type, $entity_id) {
  return db_select('recycle_bin_entity', 't')
    ->fields('t')
    ->condition('entity_type', $entity_type)
    ->condition('entity_id', (string) $entity_id)
    ->execute()
    ->fetchObject();
}

/**
 * Returns whether an entity has a current marker.
 */
function recycle_bin_is_deleted($entity_type, $entity_id) {
  return (bool) recycle_bin_get_marker($entity_type, $entity_id);
}

/**
 * Checks view access for a loaded entity that may be in the Recycle Bin.
 *
 * Entity-specific modules should call this from their normal access hook.
 * Restore and purge routes remain protected by their dedicated permissions.
 */
function recycle_bin_entity_access($entity_type, $entity, $account = NULL) {
  if (!$entity) {
    return FALSE;
  }
  $adapter = recycle_bin_get_adapter($entity_type);
  if (!$adapter) {
    return TRUE;
  }
  $entity_id = recycle_bin_adapter_entity_id($adapter, $entity);
  if (!$entity_id || !recycle_bin_is_deleted($entity_type, $entity_id)) {
    return TRUE;
  }
  return user_access('view deleted entities', $account);
}

/**
 * Soft-deletes a set of loaded nodes without invoking core delete hooks.
 */
function recycle_bin_soft_delete_nodes(array $nodes) {
  recycle_bin_soft_delete_entities('node', $nodes, recycle_bin_get_adapter('node'));
}

/**
 * Soft-deletes loaded entities without invoking permanent-delete hooks.
 */
function recycle_bin_soft_delete_entities($entity_type, array $entities, $adapter) {
  $transaction = db_transaction();
  try {
    foreach ($entities as $entity) {
      $entity_id = recycle_bin_adapter_entity_id($adapter, $entity);
      $bundle = NULL;
      if (!empty($adapter['bundle key']) && isset($entity->{$adapter['bundle key']})) {
        $bundle = $entity->{$adapter['bundle key']};
      }
      elseif (method_exists($entity, 'bundle')) {
        $bundle = $entity->bundle();
      }
      $revision = NULL;
      if (!empty($adapter['revision key']) && isset($entity->{$adapter['revision key']})) {
        $revision = $entity->{$adapter['revision key']};
      }
      db_merge('recycle_bin_entity')
        ->key(array(
          'entity_type' => $entity_type,
          'entity_id' => (string) $entity_id,
        ))
        ->fields(array(
          'bundle' => $bundle,
          'deleted' => REQUEST_TIME,
          'deleted_uid' => !empty($GLOBALS['user']->uid) ? $GLOBALS['user']->uid : 0,
          'deleted_vid' => $revision,
        ))
        ->execute();
    }
    if (!empty($adapter['cache reset callback']) && function_exists($adapter['cache reset callback'])) {
      call_user_func($adapter['cache reset callback'], array_keys($entities));
    }
    else {
      entity_get_controller($entity_type)->resetCache(array_keys($entities));
    }
    db_ignore_replica();
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog_exception('recycle_bin', $e);
    throw $e;
  }

  foreach ($entities as $entity) {
    module_invoke_all($entity_type . '_recycle_bin_delete', $entity);
    module_invoke_all('entity_recycle_bin_delete', $entity, $entity_type);
  }
}

/**
 * Restores one node from the Recycle Bin.
 */
function recycle_bin_restore_node($nid) {
  return recycle_bin_restore_entity('node', $nid);
}

/**
 * Restores one registered entity from the Recycle Bin.
 */
function recycle_bin_restore_entity($entity_type, $entity_id) {
  $adapter = recycle_bin_get_adapter($entity_type);
  $marker = recycle_bin_get_marker($entity_type, $entity_id);
  if (!$adapter || !recycle_bin_adapter_controller_is_active($entity_type)) {
    watchdog('recycle_bin', 'Cannot restore @type @id because its registered controller is not active.', array('@type' => $entity_type, '@id' => $entity_id), WATCHDOG_WARNING);
    return FALSE;
  }
  if (!$marker) {
    return FALSE;
  }
  entity_get_controller($entity_type)->resetCache(array($entity_id));
  $entity = recycle_bin_with_context('recycle_bin', 'entity_load', array($entity_type, $entity_id));
  if (!$entity) {
    return FALSE;
  }

  $transaction = db_transaction();
  try {
    db_delete('recycle_bin_entity')
      ->condition('entity_type', $entity_type)
      ->condition('entity_id', (string) $entity_id)
      ->execute();
    entity_get_controller($entity_type)->resetCache(array($entity_id));
    db_ignore_replica();
  }
  catch (Exception $e) {
    $transaction->rollback();
    watchdog_exception('recycle_bin', $e);
    throw $e;
  }

  module_invoke_all($entity_type . '_recycle_bin_restore', $entity);
  module_invoke_all('entity_recycle_bin_restore', $entity, $entity_type);
  return TRUE;
}

/**
 * Permanently purges one node while preserving core cleanup behavior.
 */
function recycle_bin_purge_node($nid) {
  return recycle_bin_purge_entity('node', $nid);
}

/**
 * Permanently purges one registered entity while preserving core cleanup.
 */
function recycle_bin_purge_entity($entity_type, $entity_id) {
  if (!recycle_bin_adapter_controller_is_active($entity_type)) {
    watchdog('recycle_bin', 'Cannot purge @type @id because its registered controller is not active.', array('@type' => $entity_type, '@id' => $entity_id), WATCHDOG_WARNING);
    return FALSE;
  }
  if (!recycle_bin_get_marker($entity_type, $entity_id)) {
    return FALSE;
  }
  entity_get_controller($entity_type)->resetCache(array($entity_id));
  $entity = recycle_bin_with_context('recycle_bin', 'entity_load', array($entity_type, $entity_id));
  if (!$entity) {
    watchdog('recycle_bin', 'Cannot purge marker for missing @type @id; marker retained.', array('@type' => $entity_type, '@id' => $entity_id), WATCHDOG_WARNING);
    return FALSE;
  }

  // Use the ignore context for the original delete path. The entity itself is
  // already loaded from the Recycle Bin, but core delete hooks must still be
  // able to load active related entities such as files referenced by a node's
  // file field. Recycle Bin context would hide those unmarked files and skip
  // their usage cleanup.
  recycle_bin_with_context('ignore', 'entity_delete_multiple', array($entity_type, array($entity_id)));
  db_delete('recycle_bin_entity')
    ->condition('entity_type', $entity_type)
    ->condition('entity_id', (string) $entity_id)
    ->execute();
  db_ignore_replica();
  module_invoke_all($entity_type . '_recycle_bin_purge', $entity);
  module_invoke_all('entity_recycle_bin_purge', $entity, $entity_type);
  return TRUE;
}

/**
 * Implements hook_cron().
 */
function recycle_bin_cron() {
  if (!config_get('recycle_bin.settings', 'auto_purge_enabled')) {
    return;
  }
  $days = max(0, (int) config_get('recycle_bin.settings', 'retention_days'));
  $limit = max(1, (int) config_get('recycle_bin.settings', 'purge_limit'));
  $cutoff = REQUEST_TIME - ($days * 86400);
  $rows = db_select('recycle_bin_entity', 't')
    ->fields('t', array('entity_type', 'entity_id'))
    ->condition('deleted', $cutoff, '<=')
    ->orderBy('deleted', 'ASC')
    ->range(0, $limit)
    ->execute();
  foreach ($rows as $row) {
    if (recycle_bin_get_adapter($row->entity_type)) {
      try {
        recycle_bin_purge_entity($row->entity_type, $row->entity_id);
      }
      catch (Exception $e) {
        watchdog_exception('recycle_bin', $e);
      }
    }
  }
}

/**
 * Settings access callback.
 */
function recycle_bin_administer_access() {
  return user_access('administer recycle bin');
}

/**
 * Recycle Bin listing access callback.
 */
function recycle_bin_access() {
  return user_access('access recycle bin') || user_access('administer recycle bin');
}

function recycle_bin_restore_access() {
  return user_access('restore deleted entities') || user_access('administer recycle bin');
}

function recycle_bin_purge_access() {
  return user_access('purge deleted entities') || user_access('administer recycle bin');
}

/**
 * Settings form.
 */
function recycle_bin_settings_form($form, &$form_state) {
  $config = config('recycle_bin.settings');
  $types = node_type_get_types();
  $options = array();
  foreach ($types as $type) {
    $options[$type->type] = $type->name;
  }
  $form['enabled_bundles'] = array(
    '#type' => 'checkboxes',
    '#title' => t('Content types that use the Recycle Bin'),
    '#options' => $options,
    '#default_value' => (array) $config->get('enabled_bundles'),
    '#description' => t('When a checked content type is deleted, it is sent to the Recycle Bin and can be restored, rather than being removed right away. Unchecked content types are deleted immediately and cannot be recovered. No content types are checked by default.'),
  );
  $form['file_adapter_enabled'] = array(
    '#type' => 'checkbox',
    '#title' => t('Send permanent managed files to the Recycle Bin instead of deleting them immediately'),
    '#default_value' => (int) $config->get('file_adapter_enabled'),
    '#description' => t('Only the file record is held in the Recycle Bin (metadata, not the file itself). Temporary files are not affected, and direct public file URLs are not hidden by this setting.'),
  );
  $form['auto_purge_enabled'] = array(
    '#type' => 'checkbox',
    '#title' => t('Automatically and permanently delete expired items'),
    '#description' => t('When enabled, items past their retention period below are permanently deleted during cron, instead of waiting for an administrator to do it manually.'),
    '#default_value' => (int) $config->get('auto_purge_enabled'),
  );
  $form['retention_days'] = array(
    '#type' => 'textfield',
    '#title' => t('Retention period (days)'),
    '#description' => t('How many days an item stays in the Recycle Bin before it is eligible for permanent deletion.'),
    '#default_value' => (int) $config->get('retention_days'),
    '#required' => TRUE,
  );
  $form['purge_limit'] = array(
    '#type' => 'textfield',
    '#title' => t('Maximum permanent deletions per cron run'),
    '#default_value' => (int) $config->get('purge_limit'),
    '#required' => TRUE,
  );
  $form['actions']['submit'] = array('#type' => 'submit', '#value' => t('Save configuration'));
  return $form;
}

function recycle_bin_settings_form_validate($form, &$form_state) {
  if (!is_numeric($form_state['values']['retention_days']) || $form_state['values']['retention_days'] < 0) {
    form_error($form['retention_days'], t('Retention must be zero or greater.'));
  }
  if (!is_numeric($form_state['values']['purge_limit']) || $form_state['values']['purge_limit'] < 1) {
    form_error($form['purge_limit'], t('Purge limit must be at least one.'));
  }
}

function recycle_bin_settings_form_submit($form, &$form_state) {
  $values = $form_state['values'];
  $enabled = array_values(array_filter((array) $values['enabled_bundles']));
  config('recycle_bin.settings')
    ->set('enabled_bundles', $enabled)
    ->set('file_adapter_enabled', !empty($values['file_adapter_enabled']))
    ->set('auto_purge_enabled', !empty($values['auto_purge_enabled']))
    ->set('retention_days', (int) $values['retention_days'])
    ->set('purge_limit', (int) $values['purge_limit'])
    ->save();
  backdrop_set_message(t('Recycle Bin configuration saved.'));
}

/**
 * Returns a display label for a deleted entity.
 */
function recycle_bin_entity_label($entity_type, $entity, $entity_id) {
  if (!$entity) {
    return t('[Missing @type @id]', array('@type' => $entity_type, '@id' => $entity_id));
  }
  if ($entity_type === 'node' && isset($entity->title)) {
    return $entity->title;
  }
  if ($entity_type === 'file') {
    return !empty($entity->filename) ? $entity->filename : $entity->uri;
  }
  return entity_label($entity_type, $entity);
}

/**
 * Lists current Recycle Bin markers for all registered adapters.
 */
function recycle_bin_listing() {
  $query = db_select('recycle_bin_entity', 't')
    ->fields('t')
    ->orderBy('deleted', 'DESC');
  $query->extend('PagerDefault')->limit(50);

  $markers = array();
  $ids_by_type = array();
  foreach ($query->execute() as $marker) {
    if (!recycle_bin_get_adapter($marker->entity_type)) {
      continue;
    }
    $markers[] = $marker;
    $ids_by_type[$marker->entity_type][] = $marker->entity_id;
  }

  $entities_by_type = array();
  foreach ($ids_by_type as $entity_type => $ids) {
    $entities_by_type[$entity_type] = recycle_bin_with_context('recycle_bin', 'entity_load_multiple', array($entity_type, $ids));
  }

  $rows = array();
  foreach ($markers as $marker) {
    $entity = isset($entities_by_type[$marker->entity_type][$marker->entity_id]) ? $entities_by_type[$marker->entity_type][$marker->entity_id] : FALSE;
    $title = recycle_bin_entity_label($marker->entity_type, $entity, $marker->entity_id);
    $operations = array();
    if ($entity) {
      if ($marker->entity_type === 'node') {
        $restore_path = 'admin/content/recycle-bin/' . $marker->entity_id . '/restore';
        $purge_path = 'admin/content/recycle-bin/' . $marker->entity_id . '/purge';
      }
      else {
        $restore_path = 'admin/content/recycle-bin/' . $marker->entity_type . '/' . $marker->entity_id . '/restore';
        $purge_path = 'admin/content/recycle-bin/' . $marker->entity_type . '/' . $marker->entity_id . '/purge';
      }
      $operations[] = l(t('Restore'), $restore_path);
      $operations[] = l(t('Delete permanently'), $purge_path);
    }
    $rows[] = array(
      check_plain($title),
      check_plain($marker->entity_type),
      check_plain($marker->bundle),
      format_date($marker->deleted),
      implode(' | ', $operations),
    );
  }

  // The entities were loaded in Recycle Bin context for display. Do not leave
  // those objects in the normal entity cache where an active load in this
  // request could bypass the marker visibility filter.
  foreach ($ids_by_type as $entity_type => $ids) {
    entity_get_controller($entity_type)->resetCache($ids);
  }

  $build['table'] = array(
    '#theme' => 'table',
    '#header' => array(t('Item'), t('Entity type'), t('Bundle'), t('Deleted'), t('Operations')),
    '#rows' => $rows,
    '#empty' => t('The Recycle Bin is empty.'),
  );
  $build['pager'] = array('#theme' => 'pager');
  return $build;
}

/**
 * Restore confirmation form.
 */
function recycle_bin_restore_form($form, &$form_state, $nid) {
  $form['nid'] = array('#type' => 'value', '#value' => (int) $nid);
  $form['question'] = array('#markup' => '<p>' . t('Restore this node? Its stored content and revision remain unchanged.') . '</p>');
  return confirm_form($form, t('Restore node'), 'admin/content/recycle-bin', t('The node will become visible to normal queries again.'), t('Restore'));
}

function recycle_bin_restore_form_submit($form, &$form_state) {
  if (recycle_bin_restore_node($form_state['values']['nid'])) {
    backdrop_set_message(t('Node restored.'));
  }
  else {
    backdrop_set_message(t('The node could not be restored.'), 'error');
  }
  $form_state['redirect'] = 'admin/content/recycle-bin';
}

/**
 * Purge confirmation form.
 */
function recycle_bin_purge_form($form, &$form_state, $nid) {
  $form['nid'] = array('#type' => 'value', '#value' => (int) $nid);
  $form['question'] = array('#markup' => '<p>' . t('Permanently delete this content and all its data? This cannot be undone.') . '</p>');
  return confirm_form($form, t('Delete content permanently'), 'admin/content/recycle-bin', t('Core delete hooks and cleanup will run.'), t('Delete permanently'));
}

function recycle_bin_purge_form_submit($form, &$form_state) {
  if (recycle_bin_purge_node($form_state['values']['nid'])) {
    backdrop_set_message(t('Content permanently deleted.'));
  }
  else {
    backdrop_set_message(t('The content could not be permanently deleted.'), 'error');
  }
  $form_state['redirect'] = 'admin/content/recycle-bin';
}

/**
 * Generic restore confirmation form for registered entity adapters.
 */
function recycle_bin_entity_restore_form($form, &$form_state, $entity_type, $entity_id) {
  $entity = recycle_bin_with_context('recycle_bin', 'entity_load', array($entity_type, $entity_id));
  $label = recycle_bin_entity_label($entity_type, $entity, $entity_id);
  $form['entity_type'] = array('#type' => 'value', '#value' => $entity_type);
  $form['entity_id'] = array('#type' => 'value', '#value' => $entity_id);
  $form['question'] = array('#markup' => '<p>' . t('Restore %label? The stored item and its data will remain unchanged.', array('%label' => $label)) . '</p>');
  return confirm_form($form, t('Restore item'), 'admin/content/recycle-bin', t('The item will become visible to normal queries again.'), t('Restore'));
}

function recycle_bin_entity_restore_form_submit($form, &$form_state) {
  $type = $form_state['values']['entity_type'];
  $id = $form_state['values']['entity_id'];
  if (recycle_bin_restore_entity($type, $id)) {
    backdrop_set_message(t('The @type was restored.', array('@type' => $type)));
  }
  else {
    backdrop_set_message(t('The @type could not be restored.', array('@type' => $type)), 'error');
  }
  $form_state['redirect'] = 'admin/content/recycle-bin';
}

/**
 * Generic purge confirmation form for registered entity adapters.
 */
function recycle_bin_entity_purge_form($form, &$form_state, $entity_type, $entity_id) {
  $entity = recycle_bin_with_context('recycle_bin', 'entity_load', array($entity_type, $entity_id));
  $label = recycle_bin_entity_label($entity_type, $entity, $entity_id);
  $form['entity_type'] = array('#type' => 'value', '#value' => $entity_type);
  $form['entity_id'] = array('#type' => 'value', '#value' => $entity_id);
  $form['question'] = array('#markup' => '<p>' . t('Permanently delete %label? This cannot be undone.', array('%label' => $label)) . '</p>');
  return confirm_form($form, t('Delete item permanently'), 'admin/content/recycle-bin', t('Core delete hooks and cleanup will run.'), t('Delete permanently'));
}

function recycle_bin_entity_purge_form_submit($form, &$form_state) {
  $type = $form_state['values']['entity_type'];
  $id = $form_state['values']['entity_id'];
  if (recycle_bin_purge_entity($type, $id)) {
    backdrop_set_message(t('The @type was permanently deleted.', array('@type' => $type)));
  }
  else {
    backdrop_set_message(t('The @type could not be permanently deleted.', array('@type' => $type)), 'error');
  }
  $form_state['redirect'] = 'admin/content/recycle-bin';
}

/**
 * Implements hook_form_FORM_ID_alter() for node_delete_confirm().
 *
 * Core's confirmation warns that deletion cannot be undone. When the node's
 * bundle is opted into the Recycle Bin, deletion is recoverable, so the
 * confirmation must say so.
 */
function recycle_bin_form_node_delete_confirm_alter(&$form, &$form_state) {
  if (empty($form['#node']) || !recycle_bin_node_will_soft_delete($form['#node'])) {
    return;
  }
  backdrop_set_title(t('Move %title to the Recycle Bin?', array('%title' => $form['#node']->title)), PASS_THROUGH);
  $form['description']['#markup'] = recycle_bin_delete_confirm_description();
  $form['actions']['submit']['#value'] = t('Move to Recycle Bin');
}

/**
 * Implements hook_form_FORM_ID_alter() for node_multiple_delete_confirm().
 */
function recycle_bin_form_node_multiple_delete_confirm_alter(&$form, &$form_state) {
  if (empty($form['nodes'])) {
    return;
  }
  $recoverable = 0;
  $permanent = 0;
  $nids = array_filter(array_map('intval', element_children($form['nodes'])));
  foreach (node_load_multiple($nids) as $node) {
    if (recycle_bin_node_will_soft_delete($node)) {
      $recoverable++;
    }
    else {
      $permanent++;
    }
  }
  if (!$recoverable) {
    return;
  }
  if ($permanent) {
    if (!empty(config_get('recycle_bin.settings', 'auto_purge_enabled'))) {
      $days = (int) config_get('recycle_bin.settings', 'retention_days');
      $recoverable_text = $days > 0
        ? format_plural($recoverable,
            '1 content item will be moved to the Recycle Bin, where it can be restored for @days days.',
            '@count content items will be moved to the Recycle Bin, where they can be restored for @days days.',
            array('@days' => $days))
        : format_plural($recoverable,
            '1 content item will be moved to the Recycle Bin, where it can be restored.',
            '@count content items will be moved to the Recycle Bin, where they can be restored.');
    }
    else {
      $recoverable_text = format_plural($recoverable,
        '1 content item will be moved to the Recycle Bin and remains recoverable until an administrator permanently deletes it.',
        '@count content items will be moved to the Recycle Bin and remain recoverable until an administrator permanently deletes them.');
    }
    $form['description']['#markup'] = $recoverable_text
      . ' ' . format_plural($permanent,
      '1 content item is not covered by the Recycle Bin and will be permanently deleted. This cannot be undone.',
      '@count content items are not covered by the Recycle Bin and will be permanently deleted. This cannot be undone.');
  }
  else {
    backdrop_set_title(format_plural($recoverable,
      'Move this content item to the Recycle Bin?',
      'Move these content items to the Recycle Bin?'), PASS_THROUGH);
    $form['description']['#markup'] = recycle_bin_delete_confirm_description();
    $form['actions']['submit']['#value'] = t('Move to Recycle Bin');
  }
}

/**
 * Returns TRUE when deleting the node now would soft-delete it.
 */
function recycle_bin_node_will_soft_delete($node) {
  if (recycle_bin_context() !== 'active' || !recycle_bin_adapter_controller_is_active('node')) {
    return FALSE;
  }
  $adapter = recycle_bin_get_adapter('node');
  return $adapter && recycle_bin_adapter_is_enabled($adapter, $node);
}

/**
 * Implements hook_form_FORM_ID_alter() for node_type_form().
 *
 * Mirrors the central Recycle Bin settings page's per-content-type checkbox
 * onto each content type's own edit form. Both read and write the same
 * 'enabled_bundles' config list, so there is one source of truth: toggling
 * it in either place updates the other.
 */
function recycle_bin_form_node_type_form_alter(&$form, &$form_state) {
  if (empty($form['#node_type']) || !recycle_bin_administer_access()) {
    return;
  }
  $type = $form['#node_type']->type;
  $enabled = (array) config_get('recycle_bin.settings', 'enabled_bundles');
  $form['recycle_bin'] = array(
    '#type' => 'fieldset',
    '#title' => t('Recycle Bin'),
    '#collapsible' => TRUE,
    '#collapsed' => TRUE,
    '#group' => 'additional_settings',
    '#weight' => 5,
  );
  $form['recycle_bin']['recycle_bin_enabled'] = array(
    '#type' => 'checkbox',
    '#title' => t('Send deleted content to the Recycle Bin'),
    '#description' => t('When checked, deleting content of this type moves it to the Recycle Bin, where it can be restored, instead of deleting it immediately. This is the same setting as on the main !link page.', array(
      '!link' => l(t('Recycle Bin settings'), 'admin/config/content/recycle-bin'),
    )),
    '#default_value' => in_array($type, $enabled, TRUE),
  );
  $form['#submit'][] = 'recycle_bin_node_type_form_submit';
}

/**
 * Submit handler: syncs the per-type checkbox back into 'enabled_bundles'.
 */
function recycle_bin_node_type_form_submit($form, &$form_state) {
  $type = $form_state['values']['type'];
  $old_type = isset($form_state['values']['old_type']) ? $form_state['values']['old_type'] : $type;
  $enabled = (array) config_get('recycle_bin.settings', 'enabled_bundles');
  // Drop both the old machine name (in case of a rename) and the current
  // one, then re-add the current name only if the checkbox is checked.
  $enabled = array_diff($enabled, array($old_type, $type));
  if (!empty($form_state['values']['recycle_bin_enabled'])) {
    $enabled[] = $type;
  }
  config_set('recycle_bin.settings', 'enabled_bundles', array_values($enabled));
}

/**
 * Builds the recoverable-delete confirmation text.
 */
function recycle_bin_delete_confirm_description() {
  $bin = recycle_bin_access()
    ? l(t('Recycle Bin'), 'admin/content/recycle-bin')
    : t('Recycle Bin');
  $days = (int) config_get('recycle_bin.settings', 'retention_days');
  if (config_get('recycle_bin.settings', 'auto_purge_enabled') && $days > 0) {
    return format_plural($days,
      'This content will be moved to the !bin. It can be restored from there for 1 day, after which it becomes eligible for permanent deletion.',
      'This content will be moved to the !bin. It can be restored from there for @count days, after which it becomes eligible for permanent deletion.',
      array('!bin' => $bin));
  }
  return t('This content will be moved to the !bin. It can be restored from there until it is permanently deleted.', array('!bin' => $bin));
}
