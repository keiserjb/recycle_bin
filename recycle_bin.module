<?php

/**
 * @file
 * Soft delete for nodes plus registered Backdrop entity adapters.
 */

require_once dirname(__FILE__) . '/includes/recycle_bin.storage.inc';
require_once dirname(__FILE__) . '/includes/recycle_bin.node.inc';
require_once dirname(__FILE__) . '/includes/recycle_bin.file.inc';

/**
 * Implements hook_permission().
 */
function recycle_bin_permission() {
  return array(
    'administer trash' => array(
      'title' => t('Administer Recycle Bin'),
      'description' => t('Configure which node bundles use soft delete and automatic purge.'),
    ),
    'access trash' => array(
      'title' => t('Access Recycle Bin'),
      'description' => t('View the Recycle Bin listing and deleted nodes.'),
    ),
    'view deleted entities' => array(
      'title' => t('View deleted entities'),
      'description' => t('Load and inspect entities in trash context.'),
    ),
    'restore deleted entities' => array(
      'title' => t('Restore deleted entities'),
      'description' => t('Restore entities from trash.'),
    ),
    'purge deleted entities' => array(
      'title' => t('Purge deleted entities'),
      'description' => t('Permanently delete entities from trash.'),
    ),
  );
}

/**
 * Implements hook_config_info().
 */
function recycle_bin_config_info() {
  return array(
    'recycle_bin.settings' => array(
      'label' => t('Recycle Bin settings'),
      'group' => t('Content'),
    ),
  );
}

/**
 * Implements hook_entity_info_alter().
 */
function recycle_bin_entity_info_alter(&$entity_info) {
  foreach (recycle_bin_get_adapters() as $entity_type => $adapter) {
    if (empty($entity_info[$entity_type]['controller class'])) {
      continue;
    }
    $current = $entity_info[$entity_type]['controller class'];
    if ($current === $adapter['controller class']) {
      if (class_exists($adapter['replacement class'])) {
        $entity_info[$entity_type]['controller class'] = $adapter['replacement class'];
      }
      else {
        watchdog('recycle_bin', 'The replacement controller @class for @type is not available; the adapter was skipped.', array('@class' => $adapter['replacement class'], '@type' => $entity_type), WATCHDOG_WARNING);
      }
    }
    elseif ($current !== $adapter['replacement class']) {
      watchdog('recycle_bin', 'The @type controller @class was not replaced; Recycle Bin will not intercept its deletes.', array('@class' => $current, '@type' => $entity_type), WATCHDOG_WARNING);
    }
  }
}

/**
 * Implements hook_recycle_bin_adapter_info().
 *
 * The node adapter is built in. Contrib adapters are collected separately via
 * module_invoke_all() so a module such as Paragraphs can register its own
 * controller subclass and entity-specific policy.
 */
function recycle_bin_builtin_adapter_info() {
  return array(
    'node' => array(
      'entity type' => 'node',
      'controller class' => 'NodeStorageController',
      'replacement class' => 'RecycleBinNodeStorageController',
      'base table' => 'node',
      'id key' => 'nid',
      'bundle key' => 'type',
      'revision key' => 'vid',
      'enabled callback' => 'recycle_bin_node_adapter_enabled',
    ),
    'file' => array(
      'entity type' => 'file',
      'controller class' => 'FileStorageController',
      'replacement class' => 'RecycleBinFileStorageController',
      'base table' => 'file_managed',
      'id key' => 'fid',
      'bundle key' => 'type',
      'revision key' => NULL,
      'enabled callback' => 'recycle_bin_file_adapter_enabled',
    ),
  );
}

/**
 * Returns the validated adapter registry.
 */
function recycle_bin_get_adapters() {
  $adapters = &backdrop_static(__FUNCTION__);
  if (isset($adapters)) {
    return $adapters;
  }

  $adapters = recycle_bin_builtin_adapter_info();
  foreach (module_invoke_all('recycle_bin_adapter_info') as $definitions) {
    if (!is_array($definitions)) {
      continue;
    }
    foreach ($definitions as $entity_type => $definition) {
      if (is_array($definition)) {
        $definition['entity type'] = isset($definition['entity type']) ? $definition['entity type'] : $entity_type;
        $adapters[$entity_type] = $definition;
      }
    }
  }

  foreach ($adapters as $entity_type => $adapter) {
    $required = array('entity type', 'controller class', 'replacement class', 'base table', 'id key');
    foreach ($required as $key) {
      if (empty($adapter[$key])) {
        unset($adapters[$entity_type]);
        watchdog('recycle_bin', 'The adapter for @type is missing required key @key and was ignored.', array('@type' => $entity_type, '@key' => $key), WATCHDOG_WARNING);
        continue 2;
      }
    }
    if ($adapter['entity type'] !== $entity_type
      || !preg_match('/^[a-z0-9_]{1,32}$/', $entity_type)
      || !preg_match('/^[a-z0-9_]+$/', $adapter['base table'])
      || !preg_match('/^[a-z0-9_]+$/', $adapter['id key'])) {
      unset($adapters[$entity_type]);
      watchdog('recycle_bin', 'The adapter for @type contains invalid entity or SQL identifiers and was ignored.', array('@type' => $entity_type), WATCHDOG_WARNING);
      continue;
    }
    foreach (array('enabled callback', 'cache reset callback', 'load query callback', 'entity id callback') as $callback_key) {
      if (!empty($adapter[$callback_key]) && !function_exists($adapter[$callback_key])) {
        unset($adapters[$entity_type]);
        watchdog('recycle_bin', 'The adapter for @type references missing callback @callback and was ignored.', array('@type' => $entity_type, '@callback' => $adapter[$callback_key]), WATCHDOG_WARNING);
        continue 2;
      }
    }
    if (!isset($adapter['bundle key'])) {
      $adapters[$entity_type]['bundle key'] = NULL;
    }
    if (!isset($adapter['revision key'])) {
      $adapters[$entity_type]['revision key'] = NULL;
    }
    if (!isset($adapter['enabled callback'])) {
      $adapters[$entity_type]['enabled callback'] = NULL;
    }
    if (!isset($adapter['load query callback'])) {
      $adapters[$entity_type]['load query callback'] = NULL;
    }
    $adapters[$entity_type] = $adapter;
  }
  return $adapters;
}

/**
 * Returns one registered adapter, or FALSE.
 */
function recycle_bin_get_adapter($entity_type) {
  $adapters = recycle_bin_get_adapters();
  return isset($adapters[$entity_type]) ? $adapters[$entity_type] : FALSE;
}

/**
 * Returns TRUE when the adapter's replacement controller is active.
 *
 * This is a safety gate for permanent purge. If another module wins the
 * controller alter race, purge must not silently call an unwrapped delete.
 */
function recycle_bin_adapter_controller_is_active($entity_type) {
  $adapter = recycle_bin_get_adapter($entity_type);
  if (!$adapter) {
    return FALSE;
  }
  $info = entity_get_info($entity_type);
  return !empty($info['controller class']) && $info['controller class'] === $adapter['replacement class'];
}

/**
 * Built-in node opt-in policy.
 */
function recycle_bin_node_adapter_enabled($entity) {
  return recycle_bin_is_bundle_enabled('node', $entity->type);
}

/**
 * Built-in managed-file opt-in policy.
 *
 * Temporary files remain under Backdrop's normal cleanup rules. The adapter
 * only protects permanent managed files and never moves or copies file data.
 */
function recycle_bin_file_adapter_enabled($entity) {
  return (bool) config_get('recycle_bin.settings', 'file_adapter_enabled')
    && isset($entity->status)
    && (int) $entity->status === FILE_STATUS_PERMANENT;
}

/**
 * Returns an entity ID using adapter metadata or an entity method.
 */
function recycle_bin_adapter_entity_id($adapter, $entity) {
  if (!empty($adapter['entity id callback']) && function_exists($adapter['entity id callback'])) {
    return call_user_func($adapter['entity id callback'], $entity);
  }
  $key = $adapter['id key'];
  if (isset($entity->{$key})) {
    return $entity->{$key};
  }
  return method_exists($entity, 'id') ? $entity->id() : NULL;
}

/**
 * Determines whether a registered entity is opted into soft deletion.
 */
function recycle_bin_adapter_is_enabled($adapter, $entity) {
  if (!empty($adapter['enabled callback']) && function_exists($adapter['enabled callback'])) {
    return (bool) call_user_func($adapter['enabled callback'], $entity, $adapter);
  }
  return FALSE;
}

/**
 * Adds marker visibility conditions to an adapter load query.
 */
function recycle_bin_adapter_alter_load_query($query, $entity_type) {
  $context = recycle_bin_context();
  $adapter = recycle_bin_get_adapter($entity_type);
  if (!$adapter || $context === 'ignore') {
    return $query;
  }
  if (!empty($adapter['load query callback']) && function_exists($adapter['load query callback'])) {
    return call_user_func($adapter['load query callback'], $query, $context, $adapter);
  }

  $alias = $query->leftJoin(
    'recycle_bin_entity',
    'recycle_bin',
    'recycle_bin.entity_type = :recycle_bin_entity_type AND recycle_bin.entity_id = base.' . $adapter['id key'],
    array(':recycle_bin_entity_type' => $entity_type)
  );
  $operator = $context === 'trash' ? 'IS NOT NULL' : 'IS NULL';
  $query->condition($alias . '.entity_id', NULL, $operator);
  return $query;
}

