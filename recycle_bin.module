<?php

/**
 * @file
 * Soft delete for nodes plus registered Backdrop entity adapters.
 */


/**
 * Implements hook_autoload_info().
 */
function recycle_bin_autoload_info() {
  return array(
    'RecycleBinStorageAdapterTrait' => 'includes/recycle_bin.storage.inc',
    'RecycleBinNodeStorageController' => 'includes/recycle_bin.node.inc',
    'RecycleBinFileStorageController' => 'includes/recycle_bin.file.inc',
    'RecycleBinTaxonomyTermStorageController' => 'includes/recycle_bin.taxonomy_term.inc',
    'recycle_bin_handler_field_node_link_delete' => 'views/recycle_bin_handler_field_node_link_delete.inc',
  );
}

/**
 * Implements hook_permission().
 */
function recycle_bin_permission() {
  return array(
    'administer recycle bin' => array(
      'title' => t('Administer Recycle Bin'),
      'description' => t('Configure which content types send deleted items to the Recycle Bin (instead of deleting them right away) and automatic permanent deletion.'),
    ),
    'access recycle bin' => array(
      'title' => t('Access Recycle Bin'),
      'description' => t('View the Recycle Bin listing and deleted items.'),
    ),
    'view deleted entities' => array(
      'title' => t('View deleted items'),
      'description' => t('Load and inspect items in the Recycle Bin.'),
    ),
    'restore deleted entities' => array(
      'title' => t('Restore deleted items'),
      'description' => t('Restore items from the Recycle Bin.'),
    ),
    'purge deleted entities' => array(
      'title' => t('Permanently delete items'),
      'description' => t('Permanently delete items from the Recycle Bin. This cannot be undone.'),
    ),
  );
}

/**
 * Implements hook_config_info().
 */
function recycle_bin_config_info() {
  return array(
    'recycle_bin.settings' => array(
      'label' => t('Recycle Bin settings'),
      'group' => t('Content'),
    ),
  );
}

/**
 * Implements hook_entity_info_alter().
 */
function recycle_bin_entity_info_alter(&$entity_info) {
  foreach (recycle_bin_get_adapters() as $entity_type => $adapter) {
    if (empty($entity_info[$entity_type]['controller class'])) {
      continue;
    }
    $current = $entity_info[$entity_type]['controller class'];
    if ($current === $adapter['controller class']) {
      if (class_exists($adapter['replacement class'])) {
        $entity_info[$entity_type]['controller class'] = $adapter['replacement class'];
      }
      else {
        watchdog('recycle_bin', 'The replacement controller @class for @type is not available; the adapter was skipped.', array('@class' => $adapter['replacement class'], '@type' => $entity_type), WATCHDOG_WARNING);
      }
    }
    elseif ($current !== $adapter['replacement class']) {
      watchdog('recycle_bin', 'The @type controller @class was not replaced; Recycle Bin will not intercept its deletes.', array('@class' => $current, '@type' => $entity_type), WATCHDOG_WARNING);
    }
  }
}

/**
 * Implements hook_recycle_bin_adapter_info().
 *
 * The node adapter is built in. Contrib adapters are collected separately via
 * module_invoke_all() so a module such as Paragraphs can register its own
 * controller subclass and entity-specific policy.
 */
function recycle_bin_builtin_adapter_info() {
  return array(
    'node' => array(
      'entity type' => 'node',
      'controller class' => 'NodeStorageController',
      'replacement class' => 'RecycleBinNodeStorageController',
      'base table' => 'node',
      'id key' => 'nid',
      'bundle key' => 'type',
      'revision key' => 'vid',
      'enabled callback' => 'recycle_bin_node_adapter_enabled',
      // node_view_multiple() runs node-specific hooks (hook_node_view, etc.)
      // that the generic entity_view_multiple() fallback would skip, so the
      // Recycle Bin preview page uses it directly for full fidelity with a
      // node's normal page.
      'view multiple callback' => 'node_view_multiple',
      'previewable' => TRUE,
    ),
    'file' => array(
      'entity type' => 'file',
      'controller class' => 'FileStorageController',
      'replacement class' => 'RecycleBinFileStorageController',
      'base table' => 'file_managed',
      'id key' => 'fid',
      'bundle key' => 'type',
      'revision key' => NULL,
      'enabled callback' => 'recycle_bin_file_adapter_enabled',
      // Managed files have no meaningful "full page" view mode; leave
      // 'previewable' at its FALSE default so no dead View link is offered.
    ),
    'taxonomy_term' => array(
      'entity type' => 'taxonomy_term',
      'controller class' => 'TaxonomyTermController',
      'replacement class' => 'RecycleBinTaxonomyTermStorageController',
      'base table' => 'taxonomy_term_data',
      'id key' => 'tid',
      'bundle key' => 'vocabulary',
      'revision key' => NULL,
      'enabled callback' => 'recycle_bin_taxonomy_term_adapter_enabled',
      'previewable' => TRUE,
    ),
  );
}

/**
 * Returns the validated adapter registry.
 */
function recycle_bin_get_adapters() {
  $adapters = &backdrop_static(__FUNCTION__);
  if (isset($adapters)) {
    return $adapters;
  }

  $adapters = recycle_bin_builtin_adapter_info();
  foreach (module_implements('recycle_bin_adapter_info') as $module) {
    $definitions = module_invoke($module, 'recycle_bin_adapter_info');
    if (!is_array($definitions)) {
      watchdog('recycle_bin', 'The adapter definitions from @module are invalid and were ignored.', array('@module' => $module), WATCHDOG_WARNING);
      continue;
    }
    foreach ($definitions as $entity_type => $definition) {
      if (isset($adapters[$entity_type])) {
        watchdog('recycle_bin', 'The duplicate adapter for @type from @module was ignored.', array('@type' => $entity_type, '@module' => $module), WATCHDOG_WARNING);
        continue;
      }
      if (is_array($definition)) {
        $definition['entity type'] = isset($definition['entity type']) ? $definition['entity type'] : $entity_type;
        $adapters[$entity_type] = $definition;
      }
    }
  }

  foreach ($adapters as $entity_type => $adapter) {
    $required = array('entity type', 'controller class', 'replacement class', 'base table', 'id key');
    foreach ($required as $key) {
      if (empty($adapter[$key])) {
        unset($adapters[$entity_type]);
        watchdog('recycle_bin', 'The adapter for @type is missing required key @key and was ignored.', array('@type' => $entity_type, '@key' => $key), WATCHDOG_WARNING);
        continue 2;
      }
    }
    if ($adapter['entity type'] !== $entity_type
      || !preg_match('/^[a-z0-9_]{1,32}$/', $entity_type)
      || !preg_match('/^[a-z0-9_]+$/', $adapter['base table'])
      || !preg_match('/^[a-z0-9_]+$/', $adapter['id key'])) {
      unset($adapters[$entity_type]);
      watchdog('recycle_bin', 'The adapter for @type contains invalid entity or SQL identifiers and was ignored.', array('@type' => $entity_type), WATCHDOG_WARNING);
      continue;
    }
    foreach (array('enabled callback', 'cache reset callback', 'load query callback', 'entity id callback', 'view multiple callback') as $callback_key) {
      if (!empty($adapter[$callback_key]) && !function_exists($adapter[$callback_key])) {
        unset($adapters[$entity_type]);
        watchdog('recycle_bin', 'The adapter for @type references missing callback @callback and was ignored.', array('@type' => $entity_type, '@callback' => $adapter[$callback_key]), WATCHDOG_WARNING);
        continue 2;
      }
    }
    if (!isset($adapter['bundle key'])) {
      $adapters[$entity_type]['bundle key'] = NULL;
    }
    if (!isset($adapter['revision key'])) {
      $adapters[$entity_type]['revision key'] = NULL;
    }
    if (!isset($adapter['enabled callback'])) {
      $adapters[$entity_type]['enabled callback'] = NULL;
    }
    if (!isset($adapter['load query callback'])) {
      $adapters[$entity_type]['load query callback'] = NULL;
    }
    if (!isset($adapter['view multiple callback'])) {
      $adapters[$entity_type]['view multiple callback'] = NULL;
    }
    if (!isset($adapter['previewable'])) {
      $adapters[$entity_type]['previewable'] = FALSE;
    }
  }
  return $adapters;
}

/**
 * Returns one registered adapter, or FALSE.
 */
function recycle_bin_get_adapter($entity_type) {
  $adapters = recycle_bin_get_adapters();
  return isset($adapters[$entity_type]) ? $adapters[$entity_type] : FALSE;
}

/**
 * Returns TRUE when the adapter's replacement controller is active.
 *
 * This is a safety gate for permanent purge. If another module wins the
 * controller alter race, purge must not silently call an unwrapped delete.
 */
function recycle_bin_adapter_controller_is_active($entity_type) {
  $adapter = recycle_bin_get_adapter($entity_type);
  if (!$adapter) {
    return FALSE;
  }
  $info = entity_get_info($entity_type);
  return !empty($info['controller class']) && $info['controller class'] === $adapter['replacement class'];
}

/**
 * Built-in node opt-in policy.
 */
function recycle_bin_node_adapter_enabled($entity) {
  return recycle_bin_is_bundle_enabled('node', $entity->type);
}

/**
 * Built-in managed-file opt-in policy.
 *
 * Temporary files remain under Backdrop's normal cleanup rules. The adapter
 * only protects permanent managed files and never moves or copies file data.
 */
function recycle_bin_file_adapter_enabled($entity) {
  return (bool) config_get('recycle_bin.settings', 'file_adapter_enabled')
    && isset($entity->status)
    && (int) $entity->status === FILE_STATUS_PERMANENT;
}

/**
 * Built-in taxonomy term opt-in policy.
 */
function recycle_bin_taxonomy_term_adapter_enabled($entity) {
  return recycle_bin_is_bundle_enabled('taxonomy_term', $entity->vocabulary);
}

/**
 * Returns an entity ID using adapter metadata or an entity method.
 */
function recycle_bin_adapter_entity_id($adapter, $entity) {
  if (!empty($adapter['entity id callback']) && function_exists($adapter['entity id callback'])) {
    return call_user_func($adapter['entity id callback'], $entity);
  }
  $key = $adapter['id key'];
  if (isset($entity->{$key})) {
    return $entity->{$key};
  }
  return method_exists($entity, 'id') ? $entity->id() : NULL;
}

/**
 * Determines whether a registered entity is opted into soft deletion.
 */
function recycle_bin_adapter_is_enabled($adapter, $entity) {
  if (!empty($adapter['enabled callback']) && function_exists($adapter['enabled callback'])) {
    return (bool) call_user_func($adapter['enabled callback'], $entity, $adapter);
  }
  return FALSE;
}

/**
 * Returns whether marker storage exists.
 */
function recycle_bin_marker_table_exists() {
  $exists = &backdrop_static(__FUNCTION__);
  if (!isset($exists)) {
    $exists = db_table_exists('recycle_bin_entity');
  }
  return $exists;
}

/**
 * Adds marker visibility conditions to an adapter load query.
 */
function recycle_bin_adapter_alter_load_query($query, $entity_type) {
  $context = recycle_bin_context();
  $adapter = recycle_bin_get_adapter($entity_type);
  if (!$adapter || $context === 'ignore' || !recycle_bin_marker_table_exists()) {
    return $query;
  }
  if (!empty($adapter['load query callback']) && function_exists($adapter['load query callback'])) {
    return call_user_func($adapter['load query callback'], $query, $context, $adapter);
  }

  $alias = $query->leftJoin(
    'recycle_bin_entity',
    'recycle_bin',
    'recycle_bin.entity_type = :recycle_bin_entity_type AND recycle_bin.entity_id = base.' . $adapter['id key'],
    array(':recycle_bin_entity_type' => $entity_type)
  );
  $operator = $context === 'recycle_bin' ? 'IS NOT NULL' : 'IS NULL';
  $query->condition($alias . '.entity_id', NULL, $operator);
  // Some entity types (taxonomy_term) also tag their own buildQuery() with a
  // core access tag (e.g. 'taxonomy_term_access') that this module separately
  // hooks for raw SQL not covered by this method. This flag stops that
  // tag-alter hook from applying a second, redundant copy of the same filter
  // when the query later executes; see recycle_bin_apply_query_marker_filter().
  $query->addMetaData('recycle_bin_filtered', TRUE);
  return $query;
}

/**
 * Implements hook_menu().
 */
function recycle_bin_menu() {
  $items['admin/config/content/recycle-bin'] = array(
    'title' => 'Recycle Bin',
    'description' => 'Configure which content types are sent to the Recycle Bin on delete, and automatic permanent deletion.',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('recycle_bin_settings_form'),
    'access callback' => 'recycle_bin_administer_access',
    'type' => MENU_NORMAL_ITEM,
  );
  $items['admin/content/recycle-bin'] = array(
    'title' => 'Recycle Bin',
    'description' => 'Review, restore, or permanently delete deleted content.',
    'page callback' => 'recycle_bin_listing',
    'access callback' => 'recycle_bin_access',
    'type' => MENU_LOCAL_TASK,
  );
  // Deliberately outside admin/* so Backdrop's Layout module resolves the
  // site's normal ('default', path: "") layout instead of 'admin_default'
  // (path: null, matched to any admin/* path) - the admin layout is a bare
  // single-column template with no sidebar/header blocks, which made this
  // preview look nothing like the node it was letting you inspect.
  $items['recycle-bin/node/%/view'] = array(
    'title' => 'View',
    'page callback' => 'recycle_bin_node_view_page',
    'page arguments' => array(2),
    'access callback' => 'recycle_bin_view_access',
    'access arguments' => array('node', 2),
    'type' => MENU_CALLBACK,
  );
  // Generic preview route for every other previewable adapter (e.g.
  // taxonomy_term). A literal path segment ('node') always wins over a '%'
  // wildcard at the same position, so this does not shadow the route above.
  $items['recycle-bin/%/%/view'] = array(
    'title' => 'View',
    'page callback' => 'recycle_bin_entity_view_page',
    'page arguments' => array(1, 2),
    'access callback' => 'recycle_bin_view_access',
    'access arguments' => array(1, 2),
    'type' => MENU_CALLBACK,
  );
  $items['admin/content/recycle-bin/%/restore'] = array(
    'title' => 'Restore',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('recycle_bin_restore_form', 3),
    'access callback' => 'recycle_bin_restore_access',
    'access arguments' => array('node', 3),
    'type' => MENU_CALLBACK,
  );
  $items['admin/content/recycle-bin/%/purge'] = array(
    'title' => 'Delete permanently',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('recycle_bin_purge_form', 3),
    'access callback' => 'recycle_bin_purge_access',
    'access arguments' => array('node', 3),
    'type' => MENU_CALLBACK,
  );
  $items['admin/content/recycle-bin/%/%/restore'] = array(
    'title' => 'Restore',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('recycle_bin_entity_restore_form', 3, 4),
    'access callback' => 'recycle_bin_restore_access',
    'access arguments' => array(3, 4),
    'type' => MENU_CALLBACK,
  );
  $items['admin/content/recycle-bin/%/%/purge'] = array(
    'title' => 'Delete permanently',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('recycle_bin_entity_purge_form', 3, 4),
    'access callback' => 'recycle_bin_purge_access',
    'access arguments' => array(3, 4),
    'type' => MENU_CALLBACK,
  );
  $items['admin/content/recycle-bin/%/%/release'] = array(
    'title' => 'Delete marker',
    'page callback' => 'backdrop_get_form',
    'page arguments' => array('recycle_bin_entity_release_form', 3, 4),
    'access callback' => 'recycle_bin_release_access',
    'access arguments' => array(3, 4),
    'type' => MENU_CALLBACK,
  );
  return $items;
}

/**
 * Implements hook_views_api().
 */
function recycle_bin_views_api() {
  return array('api' => 3);
}

/**
 * Implements hook_views_query_alter().
 *
 * This hook deliberately lives in the main module file. Views may satisfy its
 * data request from cache without loading MODULE.views.inc, but query-alter
 * hooks must apply on every request to keep deleted entities out of results.
 */
function recycle_bin_views_query_alter(&$view, &$query) {
  if (recycle_bin_context() === 'ignore') {
    return;
  }
  foreach (recycle_bin_get_adapters() as $adapter) {
    if ($view->base_table === $adapter['base table']) {
      $query->add_tag('recycle_bin');
      return;
    }
  }
}

/**
 * Implements hook_entity_query_alter().
 */
function recycle_bin_entity_query_alter($query) {
  if (!empty($query->entityConditions['entity_type']['value']) && recycle_bin_context() !== 'ignore') {
    $entity_type = $query->entityConditions['entity_type']['value'];
    $adapter = recycle_bin_get_adapter($entity_type);
    if (!$adapter) {
      return;
    }
    $query->addTag('recycle_bin');
    $query->addMetaData('recycle_bin_entity_type', $entity_type);
    $query->addMetaData('recycle_bin_base_alias', $adapter['base table']);
  }
}

/**
 * Implements hook_query_TAG_alter() for tagged EntityFieldQuery and Views SQL.
 */
function recycle_bin_query_recycle_bin_alter($query) {
  recycle_bin_apply_query_marker_filter($query);
}

/**
 * Implements hook_query_TAG_alter() for core's 'taxonomy_term_access' tag.
 *
 * Core tags several raw SQL queries with 'taxonomy_term_access' as a
 * general-purpose extension point for term-visibility filtering:
 * taxonomy_get_tree(), taxonomy_term_load_children(),
 * taxonomy_term_load_parents(), the tag autocomplete widget, and
 * TaxonomyTermController::buildQuery() itself. None of these go through
 * EntityFieldQuery or Views, so without this a soft-deleted term would still
 * show up in the admin taxonomy overview tree, its children/parents lookups,
 * and the tag autocomplete widget, even though it 404s everywhere else.
 */
function recycle_bin_query_taxonomy_term_access_alter($query) {
  recycle_bin_apply_query_marker_filter($query);
}

/**
 * Adds Recycle Bin marker visibility filtering to a raw SelectQuery.
 *
 * Shared by every hook_query_TAG_alter() implementation in this module, and
 * safe to call more than once on the same query object (e.g. a taxonomy term
 * entity load: RecycleBinStorageAdapterTrait::buildQuery() already applies
 * this filter directly, but the same query is also tagged
 * 'taxonomy_term_access' by TaxonomyTermController::buildQuery(), so
 * recycle_bin_query_taxonomy_term_access_alter() would otherwise run again
 * and left-join a second, redundant copy of the same condition when the
 * query executes) - the 'recycle_bin_filtered' metadata flag makes a second
 * call a no-op regardless of which tag handler runs first.
 */
function recycle_bin_apply_query_marker_filter($query) {
  if ($query->getMetaData('recycle_bin_filtered') || !db_table_exists('recycle_bin_entity')) {
    return;
  }
  $context = recycle_bin_context();
  if ($context === 'ignore') {
    return;
  }

  $entity_type = $query->getMetaData('recycle_bin_entity_type');
  $base_alias = $query->getMetaData('recycle_bin_base_alias');
  if (!$entity_type) {
    // Views and raw core queries supply the tag without this metadata. Find
    // a registered base table in the final SQL query before adding the
    // marker join.
    $tables = $query->getTables();
    foreach ($tables as $alias => $table) {
      if (!empty($table['table'])) {
        foreach (recycle_bin_get_adapters() as $candidate_type => $candidate) {
          if ($table['table'] === $candidate['base table']) {
            $entity_type = $candidate_type;
            $base_alias = $alias;
            break 2;
          }
        }
      }
    }
  }
  $adapter = $entity_type ? recycle_bin_get_adapter($entity_type) : FALSE;
  if (!$adapter || !$base_alias) {
    return;
  }

  $alias = $query->leftJoin(
    'recycle_bin_entity',
    'recycle_bin',
    '%alias.entity_type = :recycle_bin_entity_type AND %alias.entity_id = ' . $base_alias . '.' . $adapter['id key'],
    array(':recycle_bin_entity_type' => $entity_type)
  );
  if ($context === 'recycle_bin') {
    $query->condition($alias . '.entity_id', NULL, 'IS NOT NULL');
  }
  else {
    $query->condition($alias . '.entity_id', NULL, 'IS NULL');
  }
  $query->addMetaData('recycle_bin_filtered', TRUE);
}

/**
 * Implements hook_node_access().
 */
function recycle_bin_node_access($op, $node, $account) {
  if (empty($node->nid) || !recycle_bin_is_deleted('node', $node->nid)) {
    return NODE_ACCESS_IGNORE;
  }
  if (!recycle_bin_entity_access('node', $node, $account)) {
    return NODE_ACCESS_DENY;
  }
  return NODE_ACCESS_IGNORE;
}

/**
 * Implements hook_file_access().
 *
 * A metadata-only file adapter cannot protect a public URI from someone who
 * already knows it. This hook prevents normal entity access to marked files
 * while retaining permissioned inspection in Recycle Bin context.
 */
function recycle_bin_file_access($op, $file, $account) {
  if (!$file instanceof File || empty($file->fid) || !recycle_bin_is_deleted('file', $file->fid)) {
    return FILE_ACCESS_IGNORE;
  }
  if (recycle_bin_context() === 'recycle_bin' && $op === 'view' && user_access('view deleted entities', $account)) {
    return FILE_ACCESS_ALLOW;
  }
  return FILE_ACCESS_DENY;
}

/**
 * Implements hook_requirements().
 */
function recycle_bin_requirements($phase) {
  $requirements = array();
  if ($phase !== 'runtime') {
    return $requirements;
  }
  $marker_table_exists = recycle_bin_marker_table_exists();
  $requirements['recycle_bin_marker_table'] = array(
    'title' => t('Recycle Bin marker table'),
    'value' => $marker_table_exists ? t('Present') : t('Missing'),
    'severity' => $marker_table_exists ? REQUIREMENT_OK : REQUIREMENT_ERROR,
  );
  if (db_table_exists('recycle_bin_config_snapshot')) {
    $snapshot_count = db_query('SELECT COUNT(*) FROM {recycle_bin_config_snapshot}')->fetchField();
    $requirements['recycle_bin_legacy_snapshots'] = array(
      'title' => t('Recycle Bin legacy configuration snapshots'),
      'value' => format_plural($snapshot_count, '1 snapshot requires migration', '@count snapshots require migration'),
      'severity' => $snapshot_count ? REQUIREMENT_WARNING : REQUIREMENT_OK,
      'description' => $snapshot_count
        ? t('This legacy table is preserved to avoid data loss. Export or migrate its rows before removing it.')
        : t('Run database updates to remove the empty legacy table.'),
    );
  }
  foreach (recycle_bin_get_adapters() as $entity_type => $adapter) {
    $info = entity_get_info($entity_type);
    $active = !empty($info['controller class']) && $info['controller class'] === $adapter['replacement class'];
    if (!$active) {
      $requirements['recycle_bin_adapter_' . $entity_type] = array(
        'title' => t('Recycle Bin @type adapter', array('@type' => $entity_type)),
        'value' => t('Controller conflict or unavailable replacement'),
        'severity' => REQUIREMENT_WARNING,
        'description' => t('The entity remains permanently delete-only until its registered replacement controller is active.'),
      );
    }
  }
  return $requirements;
}

/**
 * Returns the current request context.
 *
 * @param string|null $context
 *   Set the context when supplied. Valid values are active, recycle_bin, and
 *   ignore.
 *
 * @return string
 *   The current context.
 */
function recycle_bin_context($context = NULL) {
  $current = &backdrop_static(__FUNCTION__, 'active');
  if ($context !== NULL) {
    if (!in_array($context, array('active', 'recycle_bin', 'ignore'), TRUE)) {
      throw new InvalidArgumentException('Invalid Recycle Bin context.');
    }
    $current = $context;
  }
  return $current;
}

/**
 * Runs a callback in a temporary context and always restores the old context.
 */
function recycle_bin_with_context($context, $callback, array $args = array()) {
  $previous = recycle_bin_context();
  recycle_bin_context($context);
  try {
    return call_user_func_array($callback, $args);
  }
  finally {
    recycle_bin_context($previous);
  }
}

/**
 * Returns whether a bundle is enabled for soft deletion.
 *
 * 'enabled_bundles' is stored per entity type: {"node": ["post"],
 * "taxonomy_term": ["tags"]}. Any adapter can reuse this as its 'enabled
 * callback', or supply its own for different opt-in logic (see the file
 * adapter's site-wide toggle for an example).
 */
function recycle_bin_is_bundle_enabled($entity_type, $bundle) {
  $enabled = config_get('recycle_bin.settings', 'enabled_bundles');
  $bundles = isset($enabled[$entity_type]) && is_array($enabled[$entity_type]) ? $enabled[$entity_type] : array();
  return in_array($bundle, $bundles, TRUE);
}

/**
 * Returns a current marker row, or FALSE.
 *
 * @param bool $lock
 *   Whether to lock the marker row until the current transaction completes.
 */
function recycle_bin_get_marker($entity_type, $entity_id, $lock = FALSE) {
  $marker_cache = &backdrop_static(__FUNCTION__, array());
  $entity_id = (string) $entity_id;
  if (!$lock && isset($marker_cache[$entity_type]) && array_key_exists($entity_id, $marker_cache[$entity_type])) {
    return $marker_cache[$entity_type][$entity_id];
  }

  $query = db_select('recycle_bin_entity', 't')
    ->fields('t')
    ->condition('entity_type', $entity_type)
    ->condition('entity_id', $entity_id);
  if ($lock) {
    $query->forUpdate();
  }
  $marker = $query->execute()->fetchObject();
  if (!$lock) {
    if (!isset($marker_cache[$entity_type])) {
      $marker_cache[$entity_type] = array();
    }
    $marker_cache[$entity_type][$entity_id] = $marker;
  }
  return $marker;
}

/**
 * Returns whether an entity has a current marker.
 */
function recycle_bin_is_deleted($entity_type, $entity_id) {
  return (bool) recycle_bin_get_marker($entity_type, $entity_id);
}

/**
 * Checks view access for a loaded entity that may be in the Recycle Bin.
 *
 * Entity-specific modules should call this from their normal access hook.
 * Restore and purge routes remain protected by their dedicated permissions.
 */
function recycle_bin_entity_access($entity_type, $entity, $account = NULL) {
  if (!$entity) {
    return FALSE;
  }
  $adapter = recycle_bin_get_adapter($entity_type);
  if (!$adapter) {
    return TRUE;
  }
  $entity_id = recycle_bin_adapter_entity_id($adapter, $entity);
  if (!$entity_id || !recycle_bin_is_deleted($entity_type, $entity_id)) {
    return TRUE;
  }
  return user_access('view deleted entities', $account);
}

/**
 * Soft-deletes a set of loaded nodes without invoking core delete hooks.
 */
function recycle_bin_soft_delete_nodes(array $nodes) {
  recycle_bin_soft_delete_entities('node', $nodes, recycle_bin_get_adapter('node'));
}

/**
 * Soft-deletes loaded entities without invoking permanent-delete hooks.
 */
function recycle_bin_soft_delete_entities($entity_type, array $entities, $adapter) {
  $transaction = db_transaction();
  $entity_ids = array();
  try {
    foreach ($entities as $entity) {
      $entity_id = recycle_bin_adapter_entity_id($adapter, $entity);
      if ($entity_id === NULL || $entity_id === '') {
        throw new InvalidArgumentException('Cannot soft-delete an entity without an ID.');
      }
      $entity_ids[] = $entity_id;
      $bundle = NULL;
      if (!empty($adapter['bundle key']) && isset($entity->{$adapter['bundle key']})) {
        $bundle = $entity->{$adapter['bundle key']};
      }
      elseif (method_exists($entity, 'bundle')) {
        $bundle = $entity->bundle();
      }
      $revision = NULL;
      if (!empty($adapter['revision key']) && isset($entity->{$adapter['revision key']})) {
        $revision = $entity->{$adapter['revision key']};
      }
      db_merge('recycle_bin_entity')
        ->key(array(
          'entity_type' => $entity_type,
          'entity_id' => (string) $entity_id,
        ))
        ->fields(array(
          'bundle' => $bundle,
          'deleted' => REQUEST_TIME,
          'deleted_uid' => !empty($GLOBALS['user']->uid) ? $GLOBALS['user']->uid : 0,
          'deleted_vid' => $revision,
          'purge_attempted' => 0,
        ))
        ->execute();
    }
    backdrop_static_reset('recycle_bin_get_marker');
    if (!empty($adapter['cache reset callback']) && function_exists($adapter['cache reset callback'])) {
      call_user_func($adapter['cache reset callback'], $entity_ids);
    }
    else {
      entity_get_controller($entity_type)->resetCache($entity_ids);
    }
    db_ignore_replica();
  }
  catch (Throwable $e) {
    $transaction->rollback();
    recycle_bin_watchdog_throwable($e);
    throw $e;
  }
  unset($transaction);

  foreach ($entities as $entity) {
    module_invoke_all($entity_type . '_recycle_bin_delete', $entity);
    module_invoke_all('entity_recycle_bin_delete', $entity, $entity_type);
  }
}

/**
 * Restores one node from the Recycle Bin.
 */
function recycle_bin_restore_node($nid) {
  return recycle_bin_restore_entity('node', $nid);
}

/**
 * Restores one registered entity from the Recycle Bin.
 */
function recycle_bin_restore_entity($entity_type, $entity_id) {
  $adapter = recycle_bin_get_adapter($entity_type);
  if (!$adapter || !recycle_bin_adapter_controller_is_active($entity_type)) {
    watchdog('recycle_bin', 'Cannot restore @type @id because its registered controller is not active.', array('@type' => $entity_type, '@id' => $entity_id), WATCHDOG_WARNING);
    return FALSE;
  }

  $transaction = db_transaction();
  try {
    // Lock the marker through the delete so a simultaneous purge cannot
    // delete an item reported as restored.
    if (!recycle_bin_get_marker($entity_type, $entity_id, TRUE)) {
      return FALSE;
    }
    entity_get_controller($entity_type)->resetCache(array($entity_id));
    $entity = recycle_bin_with_context('recycle_bin', 'entity_load', array($entity_type, $entity_id));
    if (!$entity) {
      return FALSE;
    }
    db_delete('recycle_bin_entity')
      ->condition('entity_type', $entity_type)
      ->condition('entity_id', (string) $entity_id)
      ->execute();
    backdrop_static_reset('recycle_bin_get_marker');
    entity_get_controller($entity_type)->resetCache(array($entity_id));
    db_ignore_replica();
  }
  catch (Throwable $e) {
    $transaction->rollback();
    recycle_bin_watchdog_throwable($e);
    throw $e;
  }
  unset($transaction);

  module_invoke_all($entity_type . '_recycle_bin_restore', $entity);
  module_invoke_all('entity_recycle_bin_restore', $entity, $entity_type);
  return TRUE;
}

/**
 * Permanently purges one node while preserving core cleanup behavior.
 */
function recycle_bin_purge_node($nid) {
  return recycle_bin_purge_entity('node', $nid);
}

/**
 * Permanently purges one registered entity while preserving core cleanup.
 */
function recycle_bin_purge_entity($entity_type, $entity_id) {
  if (!recycle_bin_adapter_controller_is_active($entity_type)) {
    watchdog('recycle_bin', 'Cannot purge @type @id because its registered controller is not active.', array('@type' => $entity_type, '@id' => $entity_id), WATCHDOG_WARNING);
    return FALSE;
  }
  $transaction = db_transaction();
  try {
    // Lock the marker through permanent deletion so a simultaneous restore
    // cannot remove it and report success before this purge completes.
    if (!recycle_bin_get_marker($entity_type, $entity_id, TRUE)) {
      return FALSE;
    }
    entity_get_controller($entity_type)->resetCache(array($entity_id));
    $entity = recycle_bin_with_context('recycle_bin', 'entity_load', array($entity_type, $entity_id));
    if (!$entity) {
      watchdog('recycle_bin', 'Cannot purge marker for missing @type @id; marker retained.', array('@type' => $entity_type, '@id' => $entity_id), WATCHDOG_WARNING);
      return FALSE;
    }

    // Use the ignore context for the original delete path. The entity itself is
    // already loaded from the Recycle Bin, but core delete hooks must still be
    // able to load active related entities such as files referenced by a node's
    // file field. Recycle Bin context would hide those unmarked files and skip
    // their usage cleanup.
    recycle_bin_with_context('ignore', 'entity_delete_multiple', array($entity_type, array($entity_id)));
    db_delete('recycle_bin_entity')
      ->condition('entity_type', $entity_type)
      ->condition('entity_id', (string) $entity_id)
      ->execute();
    backdrop_static_reset('recycle_bin_get_marker');
    db_ignore_replica();
  }
  catch (Throwable $e) {
    $transaction->rollback();
    recycle_bin_watchdog_throwable($e);
    throw $e;
  }
  unset($transaction);

  module_invoke_all($entity_type . '_recycle_bin_purge', $entity);
  module_invoke_all('entity_recycle_bin_purge', $entity, $entity_type);
  return TRUE;
}

/**
 * Implements hook_cron().
 */
function recycle_bin_cron() {
  if (!config_get('recycle_bin.settings', 'auto_purge_enabled')) {
    return;
  }
  $days = max(0, (int) config_get('recycle_bin.settings', 'retention_days'));
  $limit = max(1, (int) config_get('recycle_bin.settings', 'purge_limit'));
  $cutoff = REQUEST_TIME - ($days * 86400);

  $eligible_types = array();
  foreach (recycle_bin_get_adapters() as $entity_type => $adapter) {
    if (recycle_bin_adapter_controller_is_active($entity_type)) {
      $eligible_types[] = $entity_type;
    }
  }
  if (!$eligible_types) {
    return;
  }

  // A failed item waits one day before retrying. Without a retry delay, one
  // permanently broken oldest marker can consume the bounded cron range on
  // every run and starve every healthy item behind it.
  $retry_cutoff = REQUEST_TIME - 86400;
  $retry = db_or()
    ->condition('purge_attempted', 0)
    ->condition('purge_attempted', $retry_cutoff, '<=');
  $query = db_select('recycle_bin_entity', 't');
  $query->fields('t', array('entity_type', 'entity_id'))
    ->condition('entity_type', $eligible_types, 'IN')
    ->condition('deleted', $cutoff, '<=')
    ->condition($retry)
    ->orderBy('deleted', 'ASC')
    ->range(0, $limit);
  $rows = $query->execute();
  foreach ($rows as $row) {
    try {
      if (!recycle_bin_purge_entity($row->entity_type, $row->entity_id)) {
        recycle_bin_mark_purge_attempt($row->entity_type, $row->entity_id);
      }
    }
    catch (Throwable $e) {
      recycle_bin_mark_purge_attempt($row->entity_type, $row->entity_id);
      recycle_bin_watchdog_throwable($e);
    }
  }
}

/**
 * Defers a failed automatic purge so later eligible rows are not starved.
 */
function recycle_bin_mark_purge_attempt($entity_type, $entity_id) {
  db_update('recycle_bin_entity')
    ->fields(array('purge_attempted' => REQUEST_TIME))
    ->condition('entity_type', $entity_type)
    ->condition('entity_id', (string) $entity_id)
    ->execute();
}

/**
 * Restores or releases all markers before the module is disabled.
 *
 * Once this module stops running, it cannot enforce marker visibility. Making
 * that transition explicit avoids leaving records that unpredictably vanish
 * again if the module is later re-enabled.
 *
 * @return int
 *   Number of markers released.
 */
function recycle_bin_release_all_markers() {
  $released = 0;
  $rows = db_select('recycle_bin_entity', 't')
    ->fields('t', array('entity_type', 'entity_id'))
    ->execute()
    ->fetchAll();
  foreach ($rows as $row) {
    try {
      if (recycle_bin_adapter_controller_is_active($row->entity_type)
        && recycle_bin_restore_entity($row->entity_type, $row->entity_id)) {
        $released++;
        continue;
      }
    }
    catch (Throwable $e) {
      // Restore commits before notifications. A notification failure may mean
      // the marker is already gone, so record it and continue releasing the
      // remaining items instead of leaving disable half-finished.
      recycle_bin_watchdog_throwable($e);
      if (!recycle_bin_is_deleted($row->entity_type, $row->entity_id)) {
        $released++;
        continue;
      }
    }

    // Unknown adapters and missing entities cannot run a restore lifecycle.
    // Remove their marker so disabling has one deterministic meaning: no item
    // remains logically deleted by Recycle Bin.
    $released += db_delete('recycle_bin_entity')
      ->condition('entity_type', $row->entity_type)
      ->condition('entity_id', (string) $row->entity_id)
      ->execute();
    $adapter = recycle_bin_get_adapter($row->entity_type);
    if ($adapter && recycle_bin_adapter_controller_is_active($row->entity_type)) {
      entity_get_controller($row->entity_type)->resetCache(array($row->entity_id));
    }
  }
  db_ignore_replica();
  return $released;
}

/**
 * Deletes one marker row without touching entity storage.
 */
function recycle_bin_release_marker($entity_type, $entity_id) {
  $deleted = (bool) db_delete('recycle_bin_entity')
    ->condition('entity_type', $entity_type)
    ->condition('entity_id', (string) $entity_id)
    ->execute();
  if ($deleted) {
    backdrop_static_reset('recycle_bin_get_marker');
    db_ignore_replica();
  }
  return $deleted;
}

/**
 * Logs both Exception and PHP Error objects without causing a second failure.
 */
function recycle_bin_watchdog_throwable(Throwable $throwable) {
  if ($throwable instanceof Exception) {
    watchdog_exception('recycle_bin', $throwable);
    return;
  }
  watchdog('recycle_bin', '@type: @message in @file on line @line.', array(
    '@type' => get_class($throwable),
    '@message' => $throwable->getMessage(),
    '@file' => $throwable->getFile(),
    '@line' => $throwable->getLine(),
  ), WATCHDOG_ERROR);
}

/**
 * Settings access callback.
 */
function recycle_bin_administer_access() {
  return user_access('administer recycle bin');
}

/**
 * Recycle Bin listing access callback.
 */
function recycle_bin_access() {
  return user_access('access recycle bin') || user_access('administer recycle bin');
}

/**
 * Restore permission and optional route-target access callback.
 */
function recycle_bin_restore_access($entity_type = NULL, $entity_id = NULL) {
  if (!user_access('restore deleted entities') && !user_access('administer recycle bin')) {
    return FALSE;
  }
  return recycle_bin_operation_target_access($entity_type, $entity_id);
}

/**
 * Permanent-delete permission and optional route-target access callback.
 */
function recycle_bin_purge_access($entity_type = NULL, $entity_id = NULL) {
  if (!user_access('purge deleted entities') && !user_access('administer recycle bin')) {
    return FALSE;
  }
  return recycle_bin_operation_target_access($entity_type, $entity_id);
}

/**
 * Marker-release permission and optional route-target access callback.
 */
function recycle_bin_release_access($entity_type = NULL, $entity_id = NULL) {
  if (!user_access('purge deleted entities') && !user_access('administer recycle bin')) {
    return FALSE;
  }
  if ($entity_type === NULL && $entity_id === NULL) {
    return TRUE;
  }
  return recycle_bin_is_deleted($entity_type, $entity_id);
}

/**
 * Validates an optional restore or purge route target.
 */
function recycle_bin_operation_target_access($entity_type = NULL, $entity_id = NULL) {
  // Permission-only checks are used while building listing operations.
  if ($entity_type === NULL && $entity_id === NULL) {
    return TRUE;
  }
  return (bool) recycle_bin_get_adapter($entity_type)
    && recycle_bin_adapter_controller_is_active($entity_type)
    && recycle_bin_is_deleted($entity_type, $entity_id);
}

/**
 * View access callback for a Recycle Bin item preview.
 */
function recycle_bin_view_access($entity_type, $entity_id) {
  if (!user_access('view deleted entities') && !user_access('administer recycle bin')) {
    return FALSE;
  }
  $adapter = recycle_bin_get_adapter($entity_type);
  if (!$adapter || empty($adapter['previewable'])) {
    return FALSE;
  }
  return recycle_bin_is_deleted($entity_type, $entity_id);
}

/**
 * Settings form.
 */
function recycle_bin_settings_form($form, &$form_state) {
  $config = config('recycle_bin.settings');
  $enabled = (array) $config->get('enabled_bundles');

  $node_options = array();
  foreach (node_type_get_types() as $type) {
    $node_options[$type->type] = $type->name;
  }
  $form['node_enabled_bundles'] = array(
    '#type' => 'checkboxes',
    '#title' => t('Content types that use the Recycle Bin'),
    '#options' => $node_options,
    '#default_value' => isset($enabled['node']) ? (array) $enabled['node'] : array(),
    '#description' => t('When a checked content type is deleted, it is sent to the Recycle Bin and can be restored, rather than being removed right away. Unchecked content types are deleted immediately and cannot be recovered. No content types are checked by default.'),
  );

  if (module_exists('taxonomy')) {
    $term_options = array();
    foreach (taxonomy_get_vocabularies() as $vocabulary) {
      $term_options[$vocabulary->machine_name] = $vocabulary->name;
    }
    $form['taxonomy_term_enabled_bundles'] = array(
      '#type' => 'checkboxes',
      '#title' => t('Vocabularies whose terms use the Recycle Bin'),
      '#options' => $term_options,
      '#default_value' => isset($enabled['taxonomy_term']) ? (array) $enabled['taxonomy_term'] : array(),
      '#description' => t('When a checked vocabulary\'s term is deleted, it is sent to the Recycle Bin and can be restored, rather than being removed right away. Child terms are not deleted or altered when their parent is: they stay exactly as they were, they just stop appearing in the vocabulary\'s term overview until the parent is restored (their tag on any content is unaffected the whole time). Deleting a term normally also permanently deletes any now-orphaned child terms outright; that cascade is skipped entirely while the parent is only in the Recycle Bin, since the parent itself has not actually been deleted yet.'),
    );
  }
  $form['file_adapter_enabled'] = array(
    '#type' => 'checkbox',
    '#title' => t('Send permanent managed files to the Recycle Bin instead of deleting them immediately'),
    '#default_value' => (int) $config->get('file_adapter_enabled'),
    '#description' => t('Only the file record is held in the Recycle Bin (metadata, not the file itself). Temporary files are not affected, and direct public file URLs are not hidden by this setting.'),
  );
  $form['auto_purge_enabled'] = array(
    '#type' => 'checkbox',
    '#title' => t('Automatically and permanently delete expired items'),
    '#description' => t('When enabled, items past their retention period below are permanently deleted during cron, instead of waiting for an administrator to do it manually.'),
    '#default_value' => (int) $config->get('auto_purge_enabled'),
  );
  $form['retention_days'] = array(
    '#type' => 'textfield',
    '#title' => t('Retention period (days)'),
    '#description' => t('How many days an item stays in the Recycle Bin before it is eligible for permanent deletion.'),
    '#default_value' => (int) $config->get('retention_days'),
    '#required' => TRUE,
  );
  $form['purge_limit'] = array(
    '#type' => 'textfield',
    '#title' => t('Maximum permanent deletions per cron run'),
    '#default_value' => (int) $config->get('purge_limit'),
    '#required' => TRUE,
  );
  $form['actions']['submit'] = array('#type' => 'submit', '#value' => t('Save configuration'));
  return $form;
}

/**
 * Validates the Recycle Bin settings form.
 */
function recycle_bin_settings_form_validate($form, &$form_state) {
  $retention = filter_var($form_state['values']['retention_days'], FILTER_VALIDATE_INT, array(
    'options' => array('min_range' => 0),
  ));
  if ($retention === FALSE) {
    form_error($form['retention_days'], t('Retention must be a whole number of zero or greater.'));
  }
  $purge_limit = filter_var($form_state['values']['purge_limit'], FILTER_VALIDATE_INT, array(
    'options' => array('min_range' => 1),
  ));
  if ($purge_limit === FALSE) {
    form_error($form['purge_limit'], t('Purge limit must be a whole number of at least one.'));
  }
}

/**
 * Saves the Recycle Bin settings form.
 */
function recycle_bin_settings_form_submit($form, &$form_state) {
  $values = $form_state['values'];
  // Only overwrite the keys this form manages - other entity types keep
  // whatever their own adapter stored under 'enabled_bundles'.
  $enabled = (array) config_get('recycle_bin.settings', 'enabled_bundles');
  $enabled['node'] = array_values(array_filter((array) $values['node_enabled_bundles']));
  if (isset($values['taxonomy_term_enabled_bundles'])) {
    $enabled['taxonomy_term'] = array_values(array_filter((array) $values['taxonomy_term_enabled_bundles']));
  }
  config('recycle_bin.settings')
    ->set('enabled_bundles', $enabled)
    ->set('file_adapter_enabled', !empty($values['file_adapter_enabled']))
    ->set('auto_purge_enabled', !empty($values['auto_purge_enabled']))
    ->set('retention_days', (int) $values['retention_days'])
    ->set('purge_limit', (int) $values['purge_limit'])
    ->save();
  backdrop_set_message(t('Recycle Bin configuration saved.'));
}

/**
 * Returns a display label for a deleted entity.
 */
function recycle_bin_entity_label($entity_type, $entity, $entity_id) {
  if (!$entity) {
    return t('[Missing @type @id]', array('@type' => $entity_type, '@id' => $entity_id));
  }
  if ($entity_type === 'node' && isset($entity->title)) {
    return $entity->title;
  }
  if ($entity_type === 'file') {
    return !empty($entity->filename) ? $entity->filename : $entity->uri;
  }
  if ($entity_type === 'taxonomy_term' && isset($entity->name)) {
    return $entity->name;
  }
  return entity_label($entity_type, $entity);
}

/**
 * Lists current Recycle Bin markers for all registered adapters.
 */
function recycle_bin_listing() {
  $query = db_select('recycle_bin_entity', 't')
    ->fields('t')
    ->orderBy('deleted', 'DESC');
  $query->extend('PagerDefault')->limit(50);

  $markers = array();
  $ids_by_type = array();
  foreach ($query->execute() as $marker) {
    $markers[] = $marker;
    if (recycle_bin_adapter_controller_is_active($marker->entity_type)) {
      $ids_by_type[$marker->entity_type][] = $marker->entity_id;
    }
  }

  $entities_by_type = array();
  foreach ($ids_by_type as $entity_type => $ids) {
    $entities_by_type[$entity_type] = recycle_bin_with_context('recycle_bin', 'entity_load_multiple', array($entity_type, $ids));
  }

  $rows = array();
  foreach ($markers as $marker) {
    $entity = isset($entities_by_type[$marker->entity_type][$marker->entity_id]) ? $entities_by_type[$marker->entity_type][$marker->entity_id] : FALSE;
    $adapter = recycle_bin_get_adapter($marker->entity_type);
    $title = $adapter
      ? recycle_bin_entity_label($marker->entity_type, $entity, $marker->entity_id)
      : t('[Unavailable adapter @type @id]', array('@type' => $marker->entity_type, '@id' => $marker->entity_id));
    $operations = array();
    if ($entity) {
      if ($marker->entity_type === 'node') {
        $restore_path = 'admin/content/recycle-bin/' . $marker->entity_id . '/restore';
        $purge_path = 'admin/content/recycle-bin/' . $marker->entity_id . '/purge';
        $view_path = 'recycle-bin/node/' . $marker->entity_id . '/view';
      }
      else {
        $restore_path = 'admin/content/recycle-bin/' . $marker->entity_type . '/' . $marker->entity_id . '/restore';
        $purge_path = 'admin/content/recycle-bin/' . $marker->entity_type . '/' . $marker->entity_id . '/purge';
        $view_path = 'recycle-bin/' . $marker->entity_type . '/' . $marker->entity_id . '/view';
      }
      if (!empty($adapter['previewable']) && recycle_bin_view_access($marker->entity_type, $marker->entity_id)) {
        $operations[] = l(t('View'), $view_path);
      }
      if (recycle_bin_restore_access()) {
        $operations[] = l(t('Restore'), $restore_path);
      }
      if (recycle_bin_purge_access()) {
        $operations[] = l(t('Delete permanently'), $purge_path);
      }
    }
    else {
      if (recycle_bin_release_access($marker->entity_type, $marker->entity_id)) {
        $operations[] = l(t('Delete marker'), 'admin/content/recycle-bin/' . $marker->entity_type . '/' . $marker->entity_id . '/release');
      }
    }
    $rows[] = array(
      check_plain($title),
      check_plain($marker->entity_type),
      check_plain($marker->bundle),
      format_date($marker->deleted),
      implode(' | ', $operations),
    );
  }

  // The entities were loaded in Recycle Bin context for display. Do not leave
  // those objects in the normal entity cache where an active load in this
  // request could bypass the marker visibility filter.
  foreach ($ids_by_type as $entity_type => $ids) {
    entity_get_controller($entity_type)->resetCache($ids);
  }

  $build['table'] = array(
    '#theme' => 'table',
    '#header' => array(t('Item'), t('Entity type'), t('Bundle'), t('Deleted'), t('Operations')),
    '#rows' => $rows,
    '#empty' => t('The Recycle Bin is empty.'),
  );
  $build['pager'] = array('#theme' => 'pager');
  return $build;
}

/**
 * Implements hook_preprocess_node().
 *
 * A soft-deleted node's canonical URL 404s while it's in the Recycle Bin
 * (the marker filter hides it from normal queries), so any rendered link
 * back to it is dead. Mirrors core's "Hide the page for this content"
 * (hidden_path) behavior, which suppresses $node_url the same way for the
 * same reason: node.theme.inc unsets it for hidden-path types so the title
 * prints unlinked instead of pointing at a page nobody can reach.
 */
function recycle_bin_preprocess_node(&$variables) {
  $node = $variables['node'];
  if (!empty($node->nid) && recycle_bin_is_deleted('node', $node->nid)) {
    $variables['node_url'] = FALSE;
  }
}

/**
 * Implements hook_preprocess_taxonomy_term().
 *
 * Same dead-link problem as recycle_bin_preprocess_node(), but taxonomy
 * term.tpl.php has no hidden_path-style guard to unset $term_url onto (core
 * always wraps the term name in an <a href="<?php print $term_url; ?>">,
 * unconditionally). Point it at the Recycle Bin preview itself instead of
 * leaving it pointed at a 404.
 */
function recycle_bin_preprocess_taxonomy_term(&$variables) {
  $term = $variables['term'];
  if (!empty($term->tid)
    && recycle_bin_is_deleted('taxonomy_term', $term->tid)
    && recycle_bin_view_access('taxonomy_term', $term->tid)) {
    $variables['term_url'] = url('recycle-bin/taxonomy_term/' . $term->tid . '/view');
  }
}

/**
 * Page callback: read-only preview of a soft-deleted node.
 *
 * Thin wrapper kept as its own route (recycle-bin/node/%/view, rather than
 * the generic recycle-bin/%/%/view) so node keeps its shorter URL and its
 * node-specific view-multiple callback (see the 'node' adapter definition).
 */
function recycle_bin_node_view_page($nid) {
  return recycle_bin_entity_view_page('node', (int) $nid);
}

/**
 * Page callback: read-only preview of any soft-deleted, previewable entity.
 *
 * The entity's own canonical URL 404s while it is in the Recycle Bin (the
 * marker filter hides it from normal queries), so this loads and renders it
 * directly, letting users with the "View deleted items" permission see what
 * it contained before deciding whether to restore or permanently delete it.
 * See https://github.com/backdrop-contrib/recycle_bin/issues/3.
 *
 * Deliberately placed outside admin/* (recycle-bin/..., not
 * admin/content/recycle-bin/...): Backdrop's Layout module resolves any
 * admin/* path to the bare single-column 'admin_default' layout, which has
 * no sidebar/header blocks and made an early version of this preview look
 * nothing like the real page. Outside admin/*, the site's normal layout
 * applies instead.
 */
function recycle_bin_entity_view_page($entity_type, $entity_id) {
  $adapter = recycle_bin_get_adapter($entity_type);
  if (!$adapter || empty($adapter['previewable'])) {
    return MENU_NOT_FOUND;
  }

  // The render array a view-multiple callback returns is lazy: some of its
  // #pre_render callbacks (e.g. entity_plus's default-revision check) don't
  // actually run until backdrop_render() walks the page later, well after
  // this callback returns. By then Recycle Bin context has reverted and the
  // marker filter hides the entity again, so those late loads fail. Render
  // to a finished HTML string here, while context is still switched, instead
  // of returning the lazy array.
  //
  // Context is "ignore", not "recycle_bin": "recycle_bin" context means
  // "only show deleted items" for every registered adapter, not just this
  // one - it would hide this entity's still-active (non-deleted) related
  // entities (e.g. a node's file/image fields) the same way it would
  // incorrectly hide them during purge (see recycle_bin_purge_entity()).
  // "ignore" skips the marker filter entirely for the duration of the
  // render, so both the entity and its normal, live related entities load
  // the same way they would outside the Recycle Bin.
  $previous_context = recycle_bin_context();
  recycle_bin_context('ignore');
  try {
    $entities = entity_load($entity_type, array($entity_id));
    $entity = $entities ? reset($entities) : FALSE;
    if (!$entity) {
      return MENU_NOT_FOUND;
    }
    $view_callback = $adapter['view multiple callback'];
    $build = $view_callback
      ? call_user_func($view_callback, array($entity_id => $entity), 'full')
      : entity_view_multiple($entity_type, array($entity_id => $entity), 'full');
    $html = backdrop_render($build);
  }
  finally {
    recycle_bin_context($previous_context);
  }

  // The entity was loaded outside the marker filter for display. Do not
  // leave it in the normal entity cache where an active load in this
  // request could bypass the marker visibility filter.
  entity_get_controller($entity_type)->resetCache(array($entity_id));

  $label = recycle_bin_entity_label($entity_type, $entity, $entity_id);
  backdrop_set_title(t('@title (Recycle Bin)', array('@title' => $label)), PASS_THROUGH);

  $restore_path = $entity_type === 'node'
    ? 'admin/content/recycle-bin/' . $entity_id . '/restore'
    : 'admin/content/recycle-bin/' . $entity_type . '/' . $entity_id . '/restore';

  return array(
    'recycle_bin_notice' => array(
      '#markup' => '<div class="messages warning">' . t('This content is in the Recycle Bin and is not visible to other users. <a href="!restore">Restore it</a> to make it visible again.', array('!restore' => url($restore_path))) . '</div>',
      '#weight' => -100,
    ),
    'preview' => array(
      '#markup' => $html,
    ),
  );
}

/**
 * Restore confirmation form.
 */
function recycle_bin_restore_form($form, &$form_state, $nid) {
  $form['nid'] = array('#type' => 'value', '#value' => (int) $nid);
  $form['question'] = array('#markup' => '<p>' . t('Restore this node? Its stored content and revision remain unchanged.') . '</p>');
  return confirm_form($form, t('Restore node'), 'admin/content/recycle-bin', t('The node will become visible to normal queries again.'), t('Restore'));
}

/**
 * Submit handler for recycle_bin_restore_form().
 */
function recycle_bin_restore_form_submit($form, &$form_state) {
  if (recycle_bin_restore_node($form_state['values']['nid'])) {
    backdrop_set_message(t('Node restored.'));
  }
  else {
    backdrop_set_message(t('The node could not be restored.'), 'error');
  }
  $form_state['redirect'] = 'admin/content/recycle-bin';
}

/**
 * Purge confirmation form.
 */
function recycle_bin_purge_form($form, &$form_state, $nid) {
  $form['nid'] = array('#type' => 'value', '#value' => (int) $nid);
  $form['question'] = array('#markup' => '<p>' . t('Permanently delete this content and all its data? This cannot be undone.') . '</p>');
  return confirm_form($form, t('Delete content permanently'), 'admin/content/recycle-bin', t('Core delete hooks and cleanup will run.'), t('Delete permanently'));
}

/**
 * Submit handler for recycle_bin_purge_form().
 */
function recycle_bin_purge_form_submit($form, &$form_state) {
  if (recycle_bin_purge_node($form_state['values']['nid'])) {
    backdrop_set_message(t('Content permanently deleted.'));
  }
  else {
    backdrop_set_message(t('The content could not be permanently deleted.'), 'error');
  }
  $form_state['redirect'] = 'admin/content/recycle-bin';
}

/**
 * Generic restore confirmation form for registered entity adapters.
 */
function recycle_bin_entity_restore_form($form, &$form_state, $entity_type, $entity_id) {
  $entity = recycle_bin_with_context('recycle_bin', 'entity_load', array($entity_type, $entity_id));
  $label = recycle_bin_entity_label($entity_type, $entity, $entity_id);
  $form['entity_type'] = array('#type' => 'value', '#value' => $entity_type);
  $form['entity_id'] = array('#type' => 'value', '#value' => $entity_id);
  $form['question'] = array('#markup' => '<p>' . t('Restore %label? The stored item and its data will remain unchanged.', array('%label' => $label)) . '</p>');
  return confirm_form($form, t('Restore item'), 'admin/content/recycle-bin', t('The item will become visible to normal queries again.'), t('Restore'));
}

/**
 * Submit handler for recycle_bin_entity_restore_form().
 */
function recycle_bin_entity_restore_form_submit($form, &$form_state) {
  $type = $form_state['values']['entity_type'];
  $id = $form_state['values']['entity_id'];
  if (recycle_bin_restore_entity($type, $id)) {
    backdrop_set_message(t('The @type was restored.', array('@type' => $type)));
  }
  else {
    backdrop_set_message(t('The @type could not be restored.', array('@type' => $type)), 'error');
  }
  $form_state['redirect'] = 'admin/content/recycle-bin';
}

/**
 * Generic purge confirmation form for registered entity adapters.
 */
function recycle_bin_entity_purge_form($form, &$form_state, $entity_type, $entity_id) {
  $entity = recycle_bin_with_context('recycle_bin', 'entity_load', array($entity_type, $entity_id));
  $label = recycle_bin_entity_label($entity_type, $entity, $entity_id);
  $form['entity_type'] = array('#type' => 'value', '#value' => $entity_type);
  $form['entity_id'] = array('#type' => 'value', '#value' => $entity_id);
  $form['question'] = array('#markup' => '<p>' . t('Permanently delete %label? This cannot be undone.', array('%label' => $label)) . '</p>');
  return confirm_form($form, t('Delete item permanently'), 'admin/content/recycle-bin', t('Core delete hooks and cleanup will run.'), t('Delete permanently'));
}

/**
 * Submit handler for recycle_bin_entity_purge_form().
 */
function recycle_bin_entity_purge_form_submit($form, &$form_state) {
  $type = $form_state['values']['entity_type'];
  $id = $form_state['values']['entity_id'];
  if (recycle_bin_purge_entity($type, $id)) {
    backdrop_set_message(t('The @type was permanently deleted.', array('@type' => $type)));
  }
  else {
    backdrop_set_message(t('The @type could not be permanently deleted.', array('@type' => $type)), 'error');
  }
  $form_state['redirect'] = 'admin/content/recycle-bin';
}

/**
 * Marker-only delete confirmation form for missing entities.
 */
function recycle_bin_entity_release_form($form, &$form_state, $entity_type, $entity_id) {
  $form['entity_type'] = array('#type' => 'value', '#value' => $entity_type);
  $form['entity_id'] = array('#type' => 'value', '#value' => $entity_id);
  $form['question'] = array('#markup' => '<p>' . t('Delete the Recycle Bin marker for this missing item? The original content cannot be restored because it no longer exists.') . '</p>');
  return confirm_form($form, t('Delete marker'), 'admin/content/recycle-bin', t('Only the Recycle Bin marker will be removed.'), t('Delete marker'));
}

/**
 * Submit handler for recycle_bin_entity_release_form().
 */
function recycle_bin_entity_release_form_submit($form, &$form_state) {
  $type = $form_state['values']['entity_type'];
  $id = $form_state['values']['entity_id'];
  if (recycle_bin_release_marker($type, $id)) {
    backdrop_set_message(t('The @type marker was deleted.', array('@type' => $type)));
  }
  else {
    backdrop_set_message(t('The @type marker could not be deleted.', array('@type' => $type)), 'error');
  }
  $form_state['redirect'] = 'admin/content/recycle-bin';
}

/**
 * Implements hook_form_FORM_ID_alter() for node_delete_confirm().
 *
 * Core's confirmation warns that deletion cannot be undone. When the node's
 * bundle is opted into the Recycle Bin, deletion is recoverable, so the
 * confirmation must say so.
 */
function recycle_bin_form_node_delete_confirm_alter(&$form, &$form_state) {
  if (empty($form['#node']) || !recycle_bin_node_will_soft_delete($form['#node'])) {
    return;
  }
  backdrop_set_title(t('Move %title to the Recycle Bin?', array('%title' => $form['#node']->title)), PASS_THROUGH);
  $form['description']['#markup'] = recycle_bin_delete_confirm_description();
  $form['actions']['submit']['#value'] = t('Move to Bin');
}

/**
 * Implements hook_form_FORM_ID_alter() for node_multiple_delete_confirm().
 */
function recycle_bin_form_node_multiple_delete_confirm_alter(&$form, &$form_state) {
  if (empty($form['nodes'])) {
    return;
  }
  $recoverable = 0;
  $permanent = 0;
  $nids = array_filter(array_map('intval', element_children($form['nodes'])));
  foreach (node_load_multiple($nids) as $node) {
    if (recycle_bin_node_will_soft_delete($node)) {
      $recoverable++;
    }
    else {
      $permanent++;
    }
  }
  if (!$recoverable) {
    return;
  }
  if ($permanent) {
    if (!empty(config_get('recycle_bin.settings', 'auto_purge_enabled'))) {
      $days = (int) config_get('recycle_bin.settings', 'retention_days');
      if ($days === 0) {
        $recoverable_text = format_plural($recoverable,
          '1 content item will be moved to the Recycle Bin and permanently deleted automatically on the next cron run.',
          '@count content items will be moved to the Recycle Bin and permanently deleted automatically on the next cron run.');
      }
      else {
        $recoverable_text = format_plural($recoverable,
          '1 content item will be moved to the Recycle Bin, where it can be restored for @days days.',
          '@count content items will be moved to the Recycle Bin, where they can be restored for @days days.',
          array('@days' => $days));
      }
    }
    else {
      $recoverable_text = format_plural($recoverable,
        '1 content item will be moved to the Recycle Bin and remains recoverable until an administrator permanently deletes it.',
        '@count content items will be moved to the Recycle Bin and remain recoverable until an administrator permanently deletes them.');
    }
    $form['description']['#markup'] = $recoverable_text
      . ' ' . format_plural($permanent,
      '1 content item is not covered by the Recycle Bin and will be permanently deleted. This cannot be undone.',
      '@count content items are not covered by the Recycle Bin and will be permanently deleted. This cannot be undone.');
  }
  else {
    backdrop_set_title(format_plural($recoverable,
      'Move this content item to the Recycle Bin?',
      'Move these content items to the Recycle Bin?'), PASS_THROUGH);
    $form['description']['#markup'] = recycle_bin_delete_confirm_description();
    $form['actions']['submit']['#value'] = t('Move to Bin');
  }
}

/**
 * Implements hook_form_alter().
 *
 * Relabels the node and taxonomy term edit forms' "Delete" action link to
 * "Move to Bin" when the entity's bundle is opted into the Recycle Bin, so
 * the button reflects what will actually happen.
 */
function recycle_bin_form_alter(&$form, &$form_state, $form_id) {
  if (substr($form_id, -10) === '_node_form' && !empty($form['#node'])) {
    if (!empty($form['actions']['delete']) && recycle_bin_node_will_soft_delete($form['#node'])) {
      $form['actions']['delete']['#title'] = t('Move to Bin');
    }
    return;
  }
  if ($form_id === 'taxonomy_form_term' && !empty($form['#term']['tid']) && !empty($form['actions']['delete'])) {
    // taxonomy_form_term() stores '#term' as an array, not an entity object
    // (unlike '#node' and taxonomy_term_confirm_delete()'s '#term'); cast it
    // so recycle_bin_entity_will_soft_delete() can read ->vocabulary.
    if (recycle_bin_entity_will_soft_delete('taxonomy_term', (object) $form['#term'])) {
      $form['actions']['delete']['#value'] = t('Move to Bin');
    }
  }
}

/**
 * Implements hook_form_FORM_ID_alter() for taxonomy_term_confirm_delete().
 *
 * Mirrors recycle_bin_form_node_delete_confirm_alter(): relabels the confirm
 * button when the term's vocabulary is opted into the Recycle Bin.
 */
function recycle_bin_form_taxonomy_term_confirm_delete_alter(&$form, &$form_state) {
  if (empty($form['#term']) || !recycle_bin_entity_will_soft_delete('taxonomy_term', $form['#term'])) {
    return;
  }
  backdrop_set_title(t('Move %title to the Recycle Bin?', array('%title' => $form['#term']->name)), PASS_THROUGH);
  // Core's own description here warns that now-orphaned child terms are
  // deleted outright - that warning does not apply while this term is only
  // going to the Recycle Bin (soft delete never calls the storage
  // controller's real delete(), which is what runs that cascade; see
  // recycle_bin_settings_form()'s vocabulary checkbox description), so it is
  // replaced rather than kept, same as the node confirm form.
  $form['description']['#markup'] = recycle_bin_delete_confirm_description();
  $form['actions']['submit']['#value'] = t('Move to Bin');
}

/**
 * Returns TRUE when deleting the node now would soft-delete it.
 */
function recycle_bin_node_will_soft_delete($node) {
  return recycle_bin_entity_will_soft_delete('node', $node);
}

/**
 * Returns TRUE when deleting the entity now would soft-delete it.
 */
function recycle_bin_entity_will_soft_delete($entity_type, $entity) {
  if (recycle_bin_context() !== 'active' || !recycle_bin_adapter_controller_is_active($entity_type)) {
    return FALSE;
  }
  $adapter = recycle_bin_get_adapter($entity_type);
  return $adapter && recycle_bin_adapter_is_enabled($adapter, $entity);
}

/**
 * Implements hook_form_FORM_ID_alter() for node_type_form().
 *
 * Mirrors the central Recycle Bin settings page's per-content-type checkbox
 * onto each content type's own edit form. Both read and write the same
 * 'enabled_bundles' config list, so there is one source of truth: toggling
 * it in either place updates the other.
 */
function recycle_bin_form_node_type_form_alter(&$form, &$form_state) {
  if (empty($form['#node_type']) || !recycle_bin_administer_access()) {
    return;
  }
  $type = $form['#node_type']->type;
  $enabled = (array) config_get('recycle_bin.settings', 'enabled_bundles');
  $enabled = isset($enabled['node']) ? (array) $enabled['node'] : array();
  $form['recycle_bin'] = array(
    '#type' => 'fieldset',
    '#title' => t('Recycle Bin'),
    '#collapsible' => TRUE,
    '#collapsed' => TRUE,
    '#group' => 'additional_settings',
    '#weight' => 5,
  );
  $form['recycle_bin']['recycle_bin_enabled'] = array(
    '#type' => 'checkbox',
    '#title' => t('Send deleted content to the Recycle Bin'),
    '#description' => t('When checked, deleting content of this type moves it to the Recycle Bin, where it can be restored, instead of deleting it immediately. This is the same setting as on the main !link page.', array(
      '!link' => l(t('Recycle Bin settings'), 'admin/config/content/recycle-bin'),
    )),
    '#default_value' => in_array($type, $enabled, TRUE),
  );
  $form['#submit'][] = 'recycle_bin_node_type_form_submit';
}

/**
 * Submit handler: syncs the per-type checkbox back into 'enabled_bundles'.
 */
function recycle_bin_node_type_form_submit($form, &$form_state) {
  $type = $form_state['values']['type'];
  $old_type = isset($form_state['values']['old_type']) ? $form_state['values']['old_type'] : $type;
  $checked = !empty($form_state['values']['recycle_bin_enabled']);
  recycle_bin_set_bundle_enabled('node', $old_type, $type, $checked);
}

/**
 * Implements hook_node_type_delete().
 */
function recycle_bin_node_type_delete($type) {
  recycle_bin_set_bundle_enabled('node', $type->type, NULL, FALSE);
}

/**
 * Implements hook_taxonomy_vocabulary_delete().
 *
 * Unlike node types, vocabularies are only toggled on the central settings
 * page (no per-vocabulary mirror on the vocabulary edit form - node types
 * have one because content types are edited far more often than
 * vocabularies; add one here too if that stops being true). This hook still
 * earns its keep on its own: it stops 'enabled_bundles' from accumulating a
 * stale machine name for a vocabulary that no longer exists.
 */
function recycle_bin_taxonomy_vocabulary_delete($vocabulary) {
  recycle_bin_set_bundle_enabled('taxonomy_term', $vocabulary->machine_name, NULL, FALSE);
}

/**
 * Adds or removes one bundle from a per-entity-type 'enabled_bundles' list.
 *
 * Shared by the node type and taxonomy vocabulary form submit handlers (add
 * or rename a bundle) and their delete hooks (remove a bundle).
 *
 * @param string $entity_type
 *   The entity type whose bundle list is being updated.
 * @param string $old_bundle
 *   The bundle's current machine name in config, dropped unconditionally so
 *   a rename does not leave a stale entry behind.
 * @param string|null $new_bundle
 *   The bundle's new machine name to re-add when $enable is TRUE, or NULL
 *   when the bundle no longer exists (a delete).
 * @param bool $enable
 *   Whether the bundle should end up enabled.
 */
function recycle_bin_set_bundle_enabled($entity_type, $old_bundle, $new_bundle, $enable) {
  $enabled = (array) config_get('recycle_bin.settings', 'enabled_bundles');
  $bundles = isset($enabled[$entity_type]) ? (array) $enabled[$entity_type] : array();
  $bundles = array_diff($bundles, array_filter(array($old_bundle, $new_bundle)));
  if ($enable && $new_bundle !== NULL) {
    $bundles[] = $new_bundle;
  }
  $enabled[$entity_type] = array_values($bundles);
  config_set('recycle_bin.settings', 'enabled_bundles', $enabled);
}

/**
 * Builds the recoverable-delete confirmation text.
 */
function recycle_bin_delete_confirm_description() {
  $bin = recycle_bin_access()
    ? l(t('Recycle Bin'), 'admin/content/recycle-bin')
    : t('Recycle Bin');
  $days = (int) config_get('recycle_bin.settings', 'retention_days');
  if (config_get('recycle_bin.settings', 'auto_purge_enabled')) {
    if ($days === 0) {
      return t('This content will be moved to the !bin and permanently deleted automatically on the next cron run.', array('!bin' => $bin));
    }
    return format_plural($days,
      'This content will be moved to the !bin. It can be restored from there for 1 day, after which it becomes eligible for permanent deletion.',
      'This content will be moved to the !bin. It can be restored from there for @count days, after which it becomes eligible for permanent deletion.',
      array('!bin' => $bin));
  }
  return t('This content will be moved to the !bin. It can be restored from there until it is permanently deleted.', array('!bin' => $bin));
}
